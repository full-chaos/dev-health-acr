{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Private ACR Helm chart values",
  "description": "Structural contract for the private Dev Health ACR chart. Semantic rules (immutable-digest image, existing-Secret-only credentials, distinct runtime/migration DSN, no-MCP workload) are enforced fail-closed by templates/_helpers.tpl so that violations render a named error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "config", "credentials"],
  "properties": {
    "global": { "type": "object", "additionalProperties": true },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": {
          "type": "string",
          "description": "Immutable image reference; must be pinned to an @sha256 digest (validated at render time)."
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "contextFabric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lifecycleEnabled": {
          "type": "boolean",
          "description": "CHAOS-3916/CHAOS-3898 S2a-2 shared master switch (ACR_CONTEXT_FABRIC_GRAPH_LIFECYCLE_ENABLED) rendered into BOTH acr-api and acr-projector from this single key. Inert without readsEnabled and a correctly-populated embed.existingSecret; see docs/operations.md's CHAOS-3916 cutover runbook."
        },
        "readsEnabled": {
          "type": "boolean",
          "description": "ACR_CONTEXT_FABRIC_GRAPH_READS_ENABLED for acr-api's Investigator. lifecycleEnabled is inert on acr-api without this also being true."
        },
        "falkor": {
          "type": "object",
          "additionalProperties": false,
          "description": "ADR 0009 FalkorDB graph backend connection, consumed by acr-projector and acr-api's optional Investigator. addr must point at a self-hosted instance -- either external, or the optional in-release contextFabric.falkordb workload's Service (never auto-wired).",
          "properties": {
            "addr": { "type": "string" },
            "tls": { "type": "boolean" },
            "allowInsecure": { "type": "boolean" },
            "graphPrefix": { "type": "string" },
            "existingSecret": { "type": "string" },
            "passwordKey": { "type": "string" }
          }
        },
        "embed": {
          "type": "object",
          "additionalProperties": false,
          "description": "CHAOS-3778 embedding provider for acr-projector's vector projection. CHAOS-4147: never set baseURL without existingSecret pointing at a real key -- Configured() checks only baseURL, so a blank key still constructs a broken, vector-destroying embedder.",
          "properties": {
            "baseURL": { "type": "string" },
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "dimension": { "type": "string" },
            "timeout": { "type": "string" },
            "maxTransportRetries": { "type": "string" },
            "existingSecret": { "type": "string" },
            "apiKeyKey": { "type": "string" }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "description": "CHAOS-4076 acr-api Investigator model runtime (internal/contextfabric/modelprovider). Gated on its own explicit enabled switch, not a single field like falkor/embed, because modelprovider.Configured() opts in on ANY nonblank ACR_CONTEXT_FABRIC_MODEL* variable.",
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": { "type": "string" },
            "baseURL": { "type": "string" },
            "model": { "type": "string" },
            "fallbackModel": { "type": "string" },
            "timeout": { "type": "string" },
            "maxAttempts": { "type": "string" },
            "maxTransportRetries": { "type": "string" },
            "allowInsecureBaseURL": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "apiKeyKey": { "type": "string" }
          }
        },
        "falkordb": {
          "type": "object",
          "additionalProperties": false,
          "description": "CHAOS-4055 optional in-release FalkorDB workload (single-instance StatefulSet + Service), disabled by default; mirrors the profile-gated compose service. Enabling it never auto-configures contextFabric.falkor.addr.",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": {
              "type": "string",
              "description": "Immutable FalkorDB image reference; must be pinned to an @sha256 digest (validated at render time)."
            },
            "imagePullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "resources": { "type": "object", "additionalProperties": true },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" },
                "storageClassName": { "type": "string" }
              }
            },
            "podAnnotations": { "type": "object", "additionalProperties": true },
            "podLabels": { "type": "object", "additionalProperties": true },
            "nodeSelector": { "type": "object", "additionalProperties": true },
            "tolerations": { "type": "array" },
            "affinity": { "type": "object", "additionalProperties": true }
          }
        },
        "projector": {
          "type": "object",
          "additionalProperties": false,
          "description": "CHAOS-3753 Context Fabric projection worker: an independently deployed/scaled Deployment running the acr-projector binary from the same image, disabled by default.",
          "properties": {
            "enabled": { "type": "boolean" },
            "replicaCount": { "type": "integer", "minimum": 1 },
            "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
            "projectionEnabled": { "type": "boolean" },
            "orgIds": { "type": "array", "items": { "type": "string" } },
            "pollInterval": { "type": "string" },
            "concurrency": { "type": "integer", "minimum": 1 },
            "teamsProjectsEnabled": { "type": "boolean" },
            "podAnnotations": { "type": "object", "additionalProperties": true },
            "podLabels": { "type": "object", "additionalProperties": true },
            "nodeSelector": { "type": "object", "additionalProperties": true },
            "tolerations": { "type": "array" },
            "affinity": { "type": "object", "additionalProperties": true },
            "resources": { "type": "object", "additionalProperties": true },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "port": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenCopyImage": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["development", "test", "staging", "production"]
        },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "requestTimeout": { "type": "string" },
        "readHeaderTimeout": { "type": "string" },
        "readTimeout": { "type": "string" },
        "writeTimeout": { "type": "string" },
        "idleTimeout": { "type": "string" },
        "shutdownTimeout": { "type": "string" },
        "requireBackingStores": { "type": "boolean" },
        "localCompositionReady": { "type": "boolean" },
        "postgresConnectionKind": { "type": "string", "enum": ["direct", "pgbouncer"] },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maxOutputTokens": { "type": "integer", "minimum": 500, "maximum": 16000 },
        "maxSerializedBytes": { "type": "integer", "minimum": 8192, "maximum": 1048576 },
        "requestsPerMinute": { "type": "integer", "minimum": 1 },
        "enableEpisodeWriteback": { "type": "boolean" },
        "deviceVerificationUrl": { "type": "string" },
        "entitlement": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "url": { "type": "string" },
            "timeout": { "type": "string" },
            "tokenMountPath": { "type": "string" },
            "tokenFileName": { "type": "string" }
          }
        },
        "postgresCaBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "clickhouseCaBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "entitlementCaBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "webAssertion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": { "type": "string" },
            "audience": { "type": "string" },
            "existingSecret": { "type": "string" },
            "key": { "type": "string" },
            "mountPath": { "type": "string" }
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "migration"],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret"],
          "properties": {
            "existingSecret": { "type": "string" },
            "postgresDsnKey": { "type": "string" },
            "clickhouseDsnKey": { "type": "string" },
            "evidenceIdActiveKidKey": { "type": "string" },
            "evidenceIdKeysKey": { "type": "string" },
            "poolerAdminDsnKey": { "type": "string" }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret"],
          "properties": {
            "existingSecret": { "type": "string" },
            "postgresDsnKey": { "type": "string" },
            "poolerAdminDsnKey": { "type": "string" }
          }
        },
        "entitlementToken": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "rotationRevision": { "type": ["string", "integer"] }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "strategy": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
            "rollingUpdate": { "type": "object" }
          }
        },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "topologySpreadConstraints": { "type": "array" },
        "affinity": { "type": "object" },
        "extraContainers": { "type": "array" },
        "extraEnv": { "type": "array" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "podAnnotations": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "httpRoute": {
          "type": "object",
          "properties": {
            "parentRefs": { "type": "array" },
            "hostnames": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelectors": { "type": "array" },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": { "type": "boolean" },
            "postgresPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "clickhousePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "entitlementPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "falkorPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "kubernetesAPIPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "workloadTokenExchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "audience": { "type": "string" },
        "trustDomain": { "type": "string" },
        "consumerServiceAccounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
