{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACR MCP context_for_task Response v1",
  "description": "Output wrapper for the context_for_task MCP tool: the structured ContextPacket contract plus a required, bounded markdown rendering explicitly marked untrusted. Retrieved content is untrusted data, never instructions. The structured contract is embedded under $defs (context_packet.v1, context_packet_item.v1) so this document is self-contained and resolvable without fetching context_packet.v1.schema.json or context_packet_item.v1.schema.json separately; internal/contractcheck's drift check keeps $defs byte-for-byte synchronized with those canonical files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "structured",
    "rendered_markdown"
  ],
  "properties": {
    "schema_version": {
      "const": "mcp_context_for_task_response.v1"
    },
    "structured": {
      "$ref": "#/$defs/context_packet.v1"
    },
    "rendered_markdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markdown",
        "untrusted",
        "truncated"
      ],
      "properties": {
        "markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24000
        },
        "untrusted": {
          "const": true
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "local_context": {
      "$ref": "#/$defs/mcp_local_context.v1"
    },
    "federated_budget": {
      "$ref": "#/$defs/mcp_federated_budget.v1"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "local_context"
        ]
      },
      "then": {
        "required": [
          "federated_budget"
        ]
      }
    }
  ],
  "$defs": {
    "context_packet.v1": {
      "title": "ACR Context Packet v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "context_packet_id",
        "request_id",
        "generated_at",
        "status",
        "goal",
        "repository",
        "requested_scope",
        "resolved_scope",
        "query_version",
        "ranking_version",
        "summary",
        "items",
        "required_checks",
        "recommended_next_steps",
        "freshness",
        "coverage",
        "budget",
        "warnings",
        "compatibility"
      ],
      "properties": {
        "schema_version": {
          "const": "context_packet.v1"
        },
        "context_packet_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "degraded",
            "empty"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slug"
          ],
          "properties": {
            "slug": {
              "type": "string",
              "pattern": "^[^/\\s]+/[^/\\s]+$",
              "maxLength": 512
            },
            "repo_id": {
              "type": "string",
              "maxLength": 128
            },
            "remote_url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            }
          }
        },
        "requested_scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "maxLength": 512
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{7,64}$"
            },
            "task_ref": {
              "type": "string",
              "maxLength": 1024
            },
            "files": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "uniqueItems": true
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "time_window_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          }
        },
        "resolved_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo_id",
            "repo_slug",
            "resolution",
            "fallback_reasons"
          ],
          "properties": {
            "repo_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "repo_slug": {
              "type": "string",
              "pattern": "^[^/\\s]+/[^/\\s]+$"
            },
            "branch": {
              "type": "string",
              "maxLength": 512
            },
            "commit_sha": {
              "type": "string",
              "maxLength": 64
            },
            "resolution": {
              "enum": [
                "exact_commit",
                "branch_filtered",
                "repo_fallback",
                "unresolved"
              ]
            },
            "fallback_reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "query_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ranking_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/context_packet_item.v1"
          }
        },
        "required_checks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "label",
              "reason",
              "rule_id"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "recommended_next_steps": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "label",
              "reason",
              "rule_id"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "as_of",
            "stale_after_seconds",
            "watermarks"
          ],
          "properties": {
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "stale_after_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "watermarks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "status"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "last_ingested_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "status": {
                    "enum": [
                      "fresh",
                      "stale",
                      "missing",
                      "unavailable"
                    ]
                  }
                }
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources_considered",
            "sources_available",
            "sources_unavailable",
            "partial",
            "degraded_reasons"
          ],
          "properties": {
            "sources_considered": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "sources_available": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "sources_unavailable": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "reason"
                ],
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 1000
                  }
                }
              }
            },
            "partial": {
              "type": "boolean"
            },
            "degraded_reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_items",
            "items_used",
            "max_output_tokens",
            "estimated_tokens",
            "max_serialized_bytes",
            "serialized_bytes",
            "truncated"
          ],
          "properties": {
            "max_items": {
              "type": "integer",
              "minimum": 1
            },
            "items_used": {
              "type": "integer",
              "minimum": 0
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "estimated_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "max_serialized_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "serialized_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service_version",
            "minimum_sidecar_version",
            "supported_schema_versions"
          ],
          "properties": {
            "service_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minimum_sidecar_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "supported_schema_versions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "retrieval_debug_summary": {
          "type": "string",
          "maxLength": 8000
        }
      }
    },
    "context_packet_item.v1": {
      "title": "ACR Context Packet Item v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "packet_item_id",
        "category",
        "claim_kind",
        "title",
        "summary",
        "why_included",
        "rule_id",
        "confidence",
        "severity",
        "rank",
        "validity_scope",
        "flags",
        "related_entities",
        "evidence_ref_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "context_packet_item.v1"
        },
        "packet_item_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "category": {
          "enum": [
            "state",
            "pressure",
            "cause",
            "evidence",
            "action"
          ]
        },
        "claim_kind": {
          "enum": [
            "observed",
            "inferred",
            "recommendation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "why_included": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "high",
            "critical"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "validity_scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "maxLength": 512
            },
            "commit_sha": {
              "type": "string",
              "maxLength": 64
            },
            "valid_from": {
              "type": "string",
              "format": "date-time"
            },
            "valid_to": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stale",
            "uncertain",
            "conflicting",
            "untrusted_content"
          ],
          "properties": {
            "stale": {
              "type": "boolean"
            },
            "uncertain": {
              "type": "boolean"
            },
            "conflicting": {
              "type": "boolean"
            },
            "untrusted_content": {
              "type": "boolean"
            }
          }
        },
        "related_entities": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "label"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              }
            }
          }
        },
        "evidence_ref_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_kind": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "mcp_local_context.v1": {
      "title": "ACR MCP Local Context v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "status",
        "provider_version",
        "query_version",
        "freshness",
        "warnings",
        "items",
        "evidence_refs"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "available",
            "degraded",
            "unavailable"
          ]
        },
        "provider_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "query_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "indexed_at": {
          "type": "string",
          "format": "date-time"
        },
        "indexed_ref": {
          "type": "string",
          "maxLength": 512
        },
        "indexed_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "warnings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/context_packet_item.v1"
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/mcp_local_evidence_ref.v1"
          }
        }
      }
    },
    "mcp_federated_budget.v1": {
      "title": "ACR MCP Federated Budget v1",
      "description": "Caller maxima and usage count only hosted ContextPacket content plus local evidence content. The MCP envelope, federated_budget object, and rendered_markdown are outside these maxima.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "max_output_tokens",
        "max_serialized_bytes",
        "hosted_items_used",
        "local_items_used",
        "total_items_used",
        "hosted_estimated_tokens",
        "local_estimated_tokens",
        "total_estimated_tokens",
        "hosted_serialized_bytes",
        "local_serialized_bytes",
        "total_serialized_bytes",
        "hosted_truncated",
        "local_truncated",
        "truncated"
      ],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 500,
          "maximum": 16000
        },
        "max_serialized_bytes": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 1048576
        },
        "hosted_items_used": {
          "type": "integer",
          "minimum": 0
        },
        "local_items_used": {
          "type": "integer",
          "minimum": 0
        },
        "total_items_used": {
          "type": "integer",
          "minimum": 0
        },
        "hosted_estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "local_estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "hosted_serialized_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "local_serialized_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_serialized_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "hosted_truncated": {
          "type": "boolean"
        },
        "local_truncated": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "evidence_ref.v1": {
      "title": "ACR Evidence Reference v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_ref_id",
        "source",
        "provenance",
        "confidence",
        "citation",
        "observed_at",
        "availability"
      ],
      "properties": {
        "schema_version": {
          "const": "evidence_ref.v1"
        },
        "evidence_ref_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "entity_type",
            "entity_id",
            "display_label"
          ],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "entity_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "entity_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "display_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "safe_uri": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            }
          }
        },
        "provenance": {
          "enum": [
            "native",
            "explicit_text",
            "heuristic",
            "derived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "event_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_version": {
          "type": "string",
          "maxLength": 512
        },
        "snapshot_hash": {
          "type": "string",
          "maxLength": 256
        },
        "content_digest": {
          "type": "string",
          "maxLength": 256
        },
        "availability": {
          "enum": [
            "available",
            "stale",
            "redacted",
            "deleted",
            "unauthorized"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "mcp_local_evidence_ref.v1": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence_ref.v1"
        },
        {
          "type": "object",
          "properties": {
            "metadata": {
              "$ref": "#/$defs/mcp_local_metadata.v1"
            }
          }
        }
      ]
    },
    "mcp_local_metadata.v1": {
      "type": "object",
      "not": {
        "required": [
          "codegraph_payload"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/mcp_local_metadata_value.v1"
      }
    },
    "mcp_local_metadata_value.v1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/mcp_local_metadata.v1"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mcp_local_metadata_value.v1"
          }
        }
      ]
    }
  },
  "$id": "https://contracts.fullchaos.dev/acr/v1/mcp_context_for_task_response.v1.schema.json"
}
