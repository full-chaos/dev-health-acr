# scripts/e2e/pins.env
#
# Immutable pins for the shared ACR Kind/TLS end-to-end fixture (plan Todo 18).
#
# Every value here is a version tag paired with a resolved content digest or a
# vendored-manifest SHA-256. The fixture NEVER resolves a mutable tag at run
# time: images are pulled by digest and vendored manifests are checksum-gated
# before they are applied. Do not edit a digest without re-resolving it and
# updating the matching verification in kind-fixture.sh.
#
# shellcheck disable=SC2034  # values are consumed by kind-fixture.sh via sourcing

# --- Toolchain -------------------------------------------------------------
ACR_E2E_KIND_VERSION="v0.32.0"
# kindest/node control-plane image, pinned by digest (never the mutable tag).
ACR_E2E_NODE_IMAGE="kindest/node:v1.35.5@sha256:ce977ae6d65918d0b58a5f8b5e940429c2ce42fa3a5619ec2bbc60b949c0ac95"

# --- Vendored manifests (SHA-256 over the exact bytes under vendor/) --------
ACR_E2E_CALICO_VERSION="v3.32.1"
ACR_E2E_CALICO_MANIFEST="calico.yaml"
ACR_E2E_CALICO_SHA256="a1df919d9721cf667accdc3e72848911b0cb25cfab7d2478ad0c996302c95744"

ACR_E2E_GATEWAY_API_VERSION="v1.5.1"
ACR_E2E_GATEWAY_API_MANIFEST="gateway-api-standard.yaml"
ACR_E2E_GATEWAY_API_SHA256="751002b3b91a87f7ae3bd2517c79a47a8d7ed6702901808a1cf9bd97d284f9b8"

ACR_E2E_ENVOY_GATEWAY_VERSION="v1.7.2"
ACR_E2E_ENVOY_GATEWAY_MANIFEST="envoy-gateway.yaml"
ACR_E2E_ENVOY_GATEWAY_SHA256="6627713e21afc966d8d1101c190b43864697e21964c20a0258f7b7c614e5b9c1"

# --- Images referenced by the vendored control-plane manifests -------------
# Resolved multi-arch index digests. kind-fixture.sh preloads these into the
# node by digest and verify asserts running pods carry exactly these digests.
ACR_E2E_IMG_CALICO_CNI="quay.io/calico/cni@sha256:bb1567e3ed81e2e8414e9a68f186e1f7ffd4067a4871a9ae90896793af0190dd"
ACR_E2E_IMG_CALICO_NODE="quay.io/calico/node@sha256:7f874b3f0b540c2b523aea9961ef5e2f43b0af9056a47874c916d6cf348168d3"
ACR_E2E_IMG_CALICO_KUBE_CONTROLLERS="quay.io/calico/kube-controllers@sha256:18008f781c869376dbbc4dfb1ffe3afb46f7897887d4f20e080c420ac44a6612"
ACR_E2E_IMG_ENVOY_GATEWAY="docker.io/envoyproxy/gateway@sha256:62b7313374dde9e3db69896a37b424593a1b70210cfcd04e3535761684308a19"
ACR_E2E_IMG_ENVOY_RATELIMIT="docker.io/envoyproxy/ratelimit@sha256:084e5f5b426b43c1726f4e8c08a43400440961dbdc4a0dd0ae73a419662462a4"
# Data-plane proxy image, pinned explicitly through an EnvoyProxy resource so
# the running Envoy digest is deterministic (not EG's built-in default tag).
ACR_E2E_IMG_ENVOY_PROXY="docker.io/envoyproxy/envoy@sha256:b50d40392a05c866c4fffb5efcd17caded11d970ed1abbab317614d33377d0d7"

# --- External dependency fixtures (deployed into the fixture cluster) -------
# TLS Postgres external dependency (server TLS terminated by the container).
ACR_E2E_IMG_POSTGRES="docker.io/library/postgres@sha256:029660641a0cfc575b14f336ba448fb8a75fd595d42e1fa316b9fb4378742297"
# Read-only ClickHouse external dependency (readonly user profile enforced).
ACR_E2E_IMG_CLICKHOUSE="docker.io/clickhouse/clickhouse-server@sha256:a4e8cf46e526a06f4f52d22f7fa8d07472b55d3c896d7ca3f159e249be38ae62"
# Controlled Ops entitlement fixture (HTTPS static responder, unprivileged).
ACR_E2E_IMG_OPS_ENTITLEMENT="docker.io/nginxinc/nginx-unprivileged@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0"
# Minimal client used for in-cluster probes (NetworkPolicy, TLS, HTTP checks).
ACR_E2E_IMG_PROBE="docker.io/library/busybox@sha256:9532d8c39891ca2ecde4d30d7710e01fb739c87a8b9299685c63704296b16028"
