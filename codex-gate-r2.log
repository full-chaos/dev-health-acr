  1873		// member (see that field's own doc comment on why -- AGENTS.md's
  1874		// enum-change-requires-major-contract rule), so it never rides this
  1875		// Missing-keyed generic count -- RecordWindowGateOfferDisclosure/
  1876		// RecordWindowExpandOfferRedeemed (window.go) are its own dedicated
  1877		// telemetry instead.
  1878		// Deterministic iteration: members in Missing's own disclosure-priority
  1879		// order, sources in a fixed order -- so a caller comparing telemetry
  1880		// call sequences across two identical runs sees identical ordering.
  1881		for _, member := range needs.Missing {
  1882			for _, source := range []contractsv1.ContextFabricStructureOfferSource{contractsv1.ContextFabricStructureOfferEngine, contractsv1.ContextFabricStructureOfferPrior} {
