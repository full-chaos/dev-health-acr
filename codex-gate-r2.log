   123		if err != nil {
   124			t.Fatalf("results.Get() error = %v, want the gated result persisted for winr_ redemption", err)
   125		}
   126		if stored.Result.WindowClarification == nil || len(stored.Result.WindowClarification.Options) == 0 {
   127			t.Fatal("persisted result carries no WindowClarification options -- a follow-up could never redeem a winr_ receipt")
   128		}
   129	}
