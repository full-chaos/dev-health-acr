     9	
    10	// CHAOS-4579 / CHAOS-4531 -- the §1.3 class-conditional gate.
    11	//
    12	// chaos3900_structure_offers.go names this gap in its own words at
    13	// handleOfferMaterial's doc comment: "subject_handle is Missing whenever
    14	// this function runs (P1.C' does not yet implement §1.3's class-conditional
    15	// gate, the same known, accepted scope gap kindOfferMaterial already
    16	// carries)". anchorOfferMaterial carries the identical unconditional
    17	// disclosure on its own axis. Both builders decide their Missing row from
    18	// the CANDIDATE POOL alone; neither has ever been told what CLASS of
    19	// question it is building offers for.
    20	//
    21	// The consequence chris hit on the kiac rig (2026-08-29 19:59 PDT, "huge
    22	// miss, didn't understand plural teams still, asked for a singularity"):
    23	// turn 1 of "What teams are struggling and what are the contributing
    24	// factors?" resolves kind=team correctly, then discloses
    25	// missing=[window, subject_anchor, subject_handle] with EMPTY
    26	// AnchorOptions/HandleOptions -- the UI renders "Which repository,
    27	// project, or team?" and "Which specific item?" with no candidates behind
    28	// either. Turn 2, carrying only the window receipt, then produces the
    29	// correct discovered_cohort answer. The investigation understands the
    30	// plural intent; the clarification planner did not.
    31	//
    32	// Why this is NOT a change to the standing zero-candidates ruling
    33	// (chaos3900_structure_offers.go:1062-1067): that ruling governs
    34	// SUBJECT-BEARING shapes, where an anchor genuinely IS missing and the
    35	// empty options list is the honest "missing-and-helpful, nothing
    36	// offerable" disclosure. Its rationale does not reach a question that has
    37	// no subject axis at all -- there, nothing is missing, so disclosing it as
    38	// Missing is a false statement about the question, not a helpful one. The
    39	// ruling is preserved verbatim for every shape that has a subject axis;
    40	// see TestGateSubjectAxisOffers_SubjectBearingShapeKeepsEmptyOfferedRows.
    41	//
    42	// The signal is REUSED, never re-derived. InterpretedQuestion.Shape is the
    43	// same model-set field graphrank.DiscoveredCohort already gates the whole
    44	// cohort ranking path on (discover.go:256) and the same one
    45	// classStructurallyCompatible/fallbackClass already class the window on
    46	// (chaos3900_window_class.go:81-110). There is deliberately no second
    47	// heuristic here -- no plural-noun scan, no question-text regex. If the
    48	// interpreter's shape is wrong, that is an interpret-stage defect with one
    49	// place to fix it, not a disagreement between two detectors.
    50	//
    51	// CHAOS-4452 (the question-family investigation-planning stage) is the
    52	// structural home for this decision: a family would carry, per class, the
    53	// whole set of axes that are even applicable, and every offer builder
    54	// would consult it rather than each disclosing unconditionally and being
    55	// filtered afterwards. This gate is the narrow fix, deliberately placed at
    56	// the composition boundary so that when 4452 lands it has exactly one
    57	// call-site pair to absorb.
    58	
    59	// subjectAxisAbsent reports whether an interpreted shape has NO subject
    60	// axis at all -- the precondition for the §1.3 gate.
    61	//
    62	// discovered_cohort ONLY, and the exclusions are each deliberate:
    63	//
    64	//   - single_subject has one subject to anchor; the standing ruling applies
    65	//     unchanged.
    66	//   - explicit_cohort NAMES its members ("compare team A and team B"), so
    67	//     an anchor/handle is exactly what disambiguates which named things
    68	//     were meant -- it has a subject axis, just a plural one. This is why
    69	//     this predicate is narrower than graphrank.DiscoveredCohort's own
    70	//     two-member gate (discover.go:256), which asks a different question
    71	//     ("may this run cohort ranking?"), not this one ("does this question
    72	//     have a subject to anchor?").
    73	//   - open makes no claim about its own subject structure. Treating it as
    74	//     axis-less would silently suppress the anchor offer for every
    75	//     unclassified question -- far wider than CHAOS-4531's ruled scope
    76	//     ("only for interpreted shapes with no subject axis
    77	//     (discovered_cohort)").
    78	func subjectAxisAbsent(shape InvestigationShape) bool {
    79		return shape == ShapeDiscoveredCohort
    80	}
    81	
    82	// CohortStructureGateOutcome is the closed vocabulary
    83	// EngineTelemetry.RecordCohortStructureGate reports. Closed enum only --
    84	// no question text, no subject identifier, no offer label.
    85	type CohortStructureGateOutcome string
    86	
    87	const (
    88		// CohortStructureGateApplied: the shape had no subject axis AND the
    89		// material actually carried a subject_anchor and/or subject_handle
    90		// disclosure, which this gate removed. This is the ONLY outcome that
    91		// changed what the caller sees.
    92		CohortStructureGateApplied CohortStructureGateOutcome = "applied"
    93		// CohortStructureGateNoOp: the shape had no subject axis but the
    94		// material carried nothing on either axis, so the gate had nothing to
    95		// remove. Distinguished from "applied" so a reader can tell a gate
    96		// that FIRED from a gate that merely MATCHED -- without it, a
    97		// regression that stopped producing anchor material for an unrelated
    98		// reason would be indistinguishable, in the artifacts alone, from this
    99		// gate doing its job.
   100		CohortStructureGateNoOp CohortStructureGateOutcome = "no_op"
   101		// CohortStructureGateSubjectBearing: the shape HAS a subject axis, so
   102		// the standing zero-candidates ruling applies and the material passes
   103		// through byte-identical. Emitted so the gate's denominator is
   104		// observable: every composed disclosure reports which side of the
   105		// class decision it landed on, which is what makes
   106		// "cohort vs subject clarification" a countable split rather than an
   107		// inference from the absence of a log line.
   108		CohortStructureGateSubjectBearing CohortStructureGateOutcome = "subject_bearing"
   109	)
   110	
   111	// GateSubjectAxisOffers applies the §1.3 class-conditional gate to one
   112	// StructureOfferMaterial and reports which side of the class decision it
   113	// took.
   114	//
   115	// When the shape has no subject axis, BOTH the Missing rows and their
   116	// corresponding option lists are dropped, together. Dropping only the
   117	// Missing row would leave AnchorOptions/HandleOptions on the wire with no
   118	// member asking for them -- a receipt a caller could redeem against a need
   119	// that was never disclosed. Dropping only the options would leave exactly
   120	// the empty-offer shell CHAOS-4579 was filed about. They are one decision.
   121	//
   122	// Every other axis is untouched by construction: expected_kind (a cohort
   123	// question still legitimately narrows WHICH kind of thing the cohort is
   124	// drawn from -- chris's own turn 1 resolved kind=team correctly and that
   125	// is not the defect), window (the one question CHAOS-4579 calls
   126	// legitimate for this shape), and subject_candidate (CHAOS-4012's own
   127	// independent axis, outside CHAOS-4531's ruled scope).
   128	//
   129	// The returned material is a copy on the gated path; the input is never
   130	// mutated, so a caller holding the pre-gate material for telemetry still
   131	// reads the pre-gate truth.
   132	//
   133	// EXPORTED for exactly the reason StructureNeedsWouldDisclose is exported
   134	// (see its own doc comment, structure.go): the CHAOS-3884 replay harness
   135	// (internal/runtime/hosted) reads ResolveSubjects' StructureOfferMaterial
   136	// directly and asks whether production would disclose it, without running
   137	// the rest of Investigate. codex round 1, finding 1: after this gate
   138	// landed, that harness was asking the question against UNGATED material,
   139	// so a discovered_cohort case whose only material was anchor/handle rows
   140	// would be reported as disclosing while production discloses nothing --
   141	// a false replay report, and precisely the "two hand-written copies of
   142	// the same gate silently drift" defect StructureNeedsWouldDisclose was
   143	// exported to close. The harness now calls THIS function, so the two
   144	// cannot diverge.
   145	func GateSubjectAxisOffers(material StructureOfferMaterial, shape InvestigationShape) (StructureOfferMaterial, CohortStructureGateOutcome) {
   146		if !subjectAxisAbsent(shape) {
   147			return material, CohortStructureGateSubjectBearing
   148		}
   149		gated := material
   150		gated.Missing = nil
   151		removed := false
   152		for _, member := range material.Missing {
   153			if member == contractsv1.ContextFabricStructureNeedSubjectAnchor ||
   154				member == contractsv1.ContextFabricStructureNeedSubjectHandle {
   155				removed = true
   156				continue
   157			}
   158			gated.Missing = append(gated.Missing, member)
   159		}
   160		if len(material.AnchorOptions) > 0 || len(material.HandleOptions) > 0 {
   161			removed = true
   162		}
   163		gated.AnchorOptions = nil
   164		gated.HandleOptions = nil
   165		// AnchorOptionsRequireV2 (CHAOS-4042) is the sole signal that promotes
   166		// a result to the v2 semantic major, and it means "at least one anchor
   167		// option on this result needs membership-verify redemption". With every
   168		// anchor option removed, that statement is false -- leaving it set
   169		// would mint a v2 result carrying no v2-bearing option at all, and
   170		// unresolved.go/window.go both dispatch schemaVersion directly off this
   171		// field.
   172		gated.AnchorOptionsRequireV2 = false
   173		if !removed {
   174			return gated, CohortStructureGateNoOp
   175		}
   176		return gated, CohortStructureGateApplied
   177	}
   178	
   179	// recordCohortStructureGate is the single telemetry emission point for the
   180	// gate, shared by both call sites so the two can never drift on what they
   181	// report. nil-telemetry safe, exactly like recordStructureNeedsTelemetry.
   182	func recordCohortStructureGate(ctx context.Context, telemetry EngineTelemetry, principal storage.Principal, outcome CohortStructureGateOutcome, shape InvestigationShape) {
   183		if telemetry == nil {
   184			return
   185		}
   186		telemetry.RecordCohortStructureGate(ctx, principal, outcome, shape)
   187	}

