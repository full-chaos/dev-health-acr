  1495		}
  1496		requirements := make([]contextfabric.FactRequirement, 0, len(o.FactRequirements))
  1497		seen := make(map[contextfabric.FactKind]struct{})
  1498		for _, requirement := range o.FactRequirements {
  1499			kind := contextfabric.FactKind(strings.TrimSpace(requirement.Kind))
  1500			if _, exists := seen[kind]; exists {
  1501				continue
  1502			}
  1503			seen[kind] = struct{}{}
  1504			requirements = append(requirements, contextfabric.FactRequirement{Kind: kind, Parameters: cloneStringMap(requirement.Parameters)})
  1505		}
  1506		interpreted := contextfabric.InterpretedQuestion{
  1507			Shape: contextfabric.InvestigationShape(strings.TrimSpace(o.Shape)), RequestedJudgment: strings.TrimSpace(o.RequestedJudgment),
  1508			SubjectTerms: trimmedUnique(o.SubjectTerms), ComparisonTerms: trimmedUnique(o.ComparisonTerms),
  1509			TimeContext: timeContext, FactRequirements: requirements,
  1510			ClarificationNeeded: o.ClarificationNeeded, ClarificationReason: strings.TrimSpace(o.ClarificationReason),
  1511		}
  1512		if err := interpreted.Validate(); err != nil {
  1513			// Return interpreted (not a zero value) alongside the error: the
  1514			// caller (Runtime.InterpretQuestion) needs the actual rejected
  1515			// value to diagnose which bound it violated (CHAOS-3784 F1) --
  1516			// this is the production ModelRuntime's OWN Validate() call site,
  1517			// the only place that still has it before it would otherwise be
  1518			// discarded.
  1519			return interpreted, err
  1520		}
  1521		return interpreted, nil
  1522	}
