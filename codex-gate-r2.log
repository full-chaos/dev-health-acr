    77	
    78		result, err := engine.Investigate(context.Background(), acceptancePrincipal(), request)
    79		if err != nil {
    80			t.Fatalf("Investigate() error = %v, want a confirmation-required result, not an error", err)
    81		}
    82		if interpreter.calls != 0 {
    83			t.Fatalf("Interpret called %d times, want 0: an explicit-unconfirmed window must gate before Interpret ever runs", interpreter.calls)
    84		}
    85		if graph.resolveCalls != 0 || graph.discoverCalls != 0 {
    86			t.Fatalf("graph calls (resolve=%d, discover=%d), want 0/0: gated before any graph read", graph.resolveCalls, graph.discoverCalls)
    87		}
    88		if result.Status != InvestigationClarificationRequired {
    89			t.Fatalf("Status = %q, want clarification_required", result.Status)
    90		}
    91		if len(result.SubjectResolution.Committed) != 0 {
    92			t.Fatalf("Committed = %#v, want none: a gated result commits nothing", result.SubjectResolution.Committed)
    93		}
    94		if result.Reused {
    95			t.Fatal("Reused = true, want false: a gated result is never itself a reuse hit")
    96		}
    97		if result.WindowClarification == nil || len(result.WindowClarification.Options) == 0 {
    98			t.Fatal("WindowClarification is nil or empty, want real receipt-bound options")
    99		}
   100		// CHAOS-4118: gate 1 shares windowConfirmationRequiredResult with gate 2
   101		// (chaos4040_window_gate_test.go's own class-default test asserts this
   102		// in detail) -- the window-only StructureNeeds fix applies uniformly to
   103		// both call sites.
   104		if result.StructureNeeds == nil {
   105			t.Fatal("StructureNeeds is nil, want a window-only disclosure mirroring WindowClarification (CHAOS-4118)")
   106		}
   107		if len(result.StructureNeeds.Missing) != 1 || result.StructureNeeds.Missing[0] != contractsv1.ContextFabricStructureNeedWindow {
   108			t.Fatalf("StructureNeeds.Missing = %#v, want exactly [window]", result.StructureNeeds.Missing)
   109		}
   110		if !reflect.DeepEqual(result.StructureNeeds.WindowOptions, result.WindowClarification.Options) {
   111			t.Fatalf("StructureNeeds.WindowOptions = %#v, want the identical option set as WindowClarification.Options = %#v", result.StructureNeeds.WindowOptions, result.WindowClarification.Options)
   112		}
   113		if result.EffectiveEvidenceWindow == nil || result.EffectiveEvidenceWindow.Provenance != WindowInferredDefault {
   114			t.Fatalf("EffectiveEvidenceWindow = %#v, want a disclosed inferred_default window", result.EffectiveEvidenceWindow)
   115		}
   116		if result.DeterministicAnswer == "" {
   117			t.Fatal("DeterministicAnswer is empty, want the confirmation-required disclosure")
   118		}
   119		if result.DirectJudgment != "" || len(result.ClaimedFacts) != 0 {
