   185		if windowCanon.Effective != nil || windowCanon.BinderProposal.Reason == WindowBindRoutedInferred {
   186			return windowPriorProposal{}
   187		}
   188		var sawCandidate, revoked bool
   189		for _, entry := range entries {
   190			if entry.Member != contractsv1.ContextFabricStructureNeedWindow {
   191				continue
   192			}
   193			sawCandidate = true
   194			if entry.Revoked {
   195				revoked = true
   196				continue
   197			}
   198			candidate := RelativeWindowID(entry.Value)
   199			if !ValidRelativeWindowID(candidate) {
   200				continue
   201			}
   202			e.recordPriorConsultOutcome(ctx, principal, contractsv1.ContextFabricStructureNeedWindow, sawCandidate, true, false)
   203			return windowPriorProposal{
   204				RelativeID: candidate, PriorVersionID: strconv.FormatInt(entry.Version, 10), PriorEntryID: entry.EntryID, OK: true,
   205			}
   206		}
   207		e.recordPriorConsultOutcome(ctx, principal, contractsv1.ContextFabricStructureNeedWindow, sawCandidate, false, revoked)
   208		return windowPriorProposal{}
   209	}
