  1858		// fires independently of KindOptions (its own doc comment on
  1859		// ContextFabricStructureNeeds) but was omitted from this offer-count
  1860		// loop, so a candidate-offer StructureNeeds emitted a Missing disclosure
  1861		// with no matching cf_structure_offer_count signal.
  1862		for _, opt := range needs.CandidateOptions {
  1863			addCount(contractsv1.ContextFabricStructureNeedSubjectCandidate, opt.OfferSource)
  1864		}
  1865		// CHAOS-4118: ContextFabricWindowOption carries no OfferSource field --
  1866		// a window offer is always derived from the closed relative-window
  1867		// registry (composeWindowClarification), never prior-sourced -- so
  1868		// every entry counts as engine-sourced, unconditionally.
  1869		for range needs.WindowOptions {
  1870			addCount(contractsv1.ContextFabricStructureNeedWindow, contractsv1.ContextFabricStructureOfferEngine)
  1871		}
