   163		gated.AnchorOptions = nil
   164		gated.HandleOptions = nil
   165		// AnchorOptionsRequireV2 (CHAOS-4042) is the sole signal that promotes
   166		// a result to the v2 semantic major, and it means "at least one anchor
   167		// option on this result needs membership-verify redemption". With every
   168		// anchor option removed, that statement is false -- leaving it set
   169		// would mint a v2 result carrying no v2-bearing option at all, and
   170		// unresolved.go/window.go both dispatch schemaVersion directly off this
   171		// field.
   172		gated.AnchorOptionsRequireV2 = false
   173		if !removed {
   174			return gated, CohortStructureGateNoOp
   175		}
   176		return gated, CohortStructureGateApplied
   177	}
