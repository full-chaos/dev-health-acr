   448	
   449	// resolveTerminalStatus decides which contract status an investigation with
   450	// no committed subject carries, and may fill in a clarification prompt the
   451	// backend left empty. It invents no status: the v1 enum is
   452	// complete/partial/degraded/clarification_required/no_match, complete and
   453	// partial both require a direct judgment (which needs canonical facts), and
   454	// degraded describes limited coverage of an answer that still exists -- so
   455	// the only two outcomes available here are the two named below.
   456	//
   457	// AllowClarification=false with ambiguous candidates resolves to no_match,
   458	// NOT to a refusal or a new status. Two facts of the existing contract force
   459	// it: ContextFabricInvestigationResult.Validate rejects a
   460	// clarification_required result that carries no prompt, and a caller that set
   461	// AllowClarification=false has declined the only thing a prompt could ask
   462	// for. The candidates stay attached to the result either way -- they are
   463	// ranked and receipt-bound, so even a no_match caller can bind one through
   464	// PriorSubjectReceipts on a follow-up.
   465	// subjectlessTerminalReason (CHAOS-3888) classifies WHY resolveTerminalStatus
   466	// reached the subjectless terminal path, as a closed, telemetry-only
   467	// vocabulary -- never part of the InvestigationResult contract (see
   468	// SubjectResolution.RetrievalDegraded's own doc comment on why cause-level
   469	// retrieval detail stays out of the answer-facing response, a discipline
   470	// that applies with EXTRA force here: telling a caller their empty result
   471	// was specifically authorization-narrowed, rather than a genuine absence,
   472	// would be exactly the kind of existence-oracle leak CHAOS-3829's
   473	// unscopedVisibility guard exists to prevent on the resolution side).
   474	//
   475	//   - "graph_not_projected" (CHAOS-4077): the candidate pool was empty
   476	//     because the organization's graph has never been projected at all
   477	//     (SubjectResolution.GraphNotProjected) -- checked FIRST, ahead of
   478	//     authz_filtered_to_empty/empty_pool, because those two both presume a
   479	//     real search ran against a real graph and is reporting on WHAT it
   480	//     found; here no search could run at all, which is a different
   481	//     operator response (run the projector for this org) than either.
   482	//   - "empty_pool": the candidate pool was empty and nothing this
   483	//     resolution found was excluded by authorization -- a true absence (or
   484	//     at least, retrieval genuinely found nothing to exclude either way).
   485	//   - "authz_filtered_to_empty": the candidate pool was empty AND this
   486	//     resolution's own GraphReader reported (via
   487	//     RecordSubjectCandidatesAuthzDropped) that it excluded at least one
   488	//     candidate purely on authorization grounds -- structurally distinct
   489	//     from empty_pool: something existed, and authorization hid it.
   490	//   - "ambiguous": the candidate pool was non-empty (one or more
   491	//     uncommitted candidates) -- the clarification_required / no_match
   492	//     "more than one matched, or one matched but did not clear the commit
   493	//     gate" branch, regardless of AllowClarification.
   494	func subjectlessTerminalReason(resolution SubjectResolution, subjectCandidatesAuthzDropped int) string {
   495		if len(resolution.Candidates) > 0 {
   496			return "ambiguous"
   497		}
   498		if resolution.GraphNotProjected {
   499			return "graph_not_projected"
   500		}
   501		if subjectCandidatesAuthzDropped > 0 {
   502			return "authz_filtered_to_empty"
   503		}
   504		return "empty_pool"
   505	}
   506	
   507	func resolveTerminalStatus(request InvestigationRequest, resolution *SubjectResolution) (InvestigationStatus, string) {
   508		if len(resolution.Candidates) == 0 {
   509			return InvestigationNoMatch, noMatchLimitationForEmptyPool(resolution)
   510		}
   511		// Exactly one uncommitted candidate is a REACHABLE state, not a
   512		// theoretical one: ResolveFromMergedCandidates leaves a lone candidate
   513		// uncommitted whenever it misses the 0.72 gate. Prose that says "more
   514		// than one" beside a single listed candidate contradicts the payload it
   515		// travels with (codex round-2 F1).
   516		single := len(resolution.Candidates) == 1
   517		if !request.Options.AllowClarification {
   518			if single {
   519				return InvestigationNoMatch, ambiguousNoClarificationLimitationOne
   520			}
   521			return InvestigationNoMatch, ambiguousNoClarificationLimitation
   522		}
   523		if strings.TrimSpace(resolution.ClarificationPrompt) == "" {
   524			if single {
   525				resolution.ClarificationPrompt = fallbackClarificationPromptOne
   526			} else {
   527				resolution.ClarificationPrompt = fallbackClarificationPrompt
   528			}
   529		}
   530		if single {
   531			return InvestigationClarificationRequired, clarificationRequiredLimitationOne
   532		}
   533		return InvestigationClarificationRequired, clarificationRequiredLimitation
   534	}
   535	
   536	// noMatchLimitationForEmptyPool selects the limitation prose an empty
   537	// candidate pool carries. It is the seam Phase 6 (resolution architecture v3
   538	// §9.2/§21) extends: once a candidate pool carries a closed completeness
   539	// proof for its key class, this function is where the branch to a SOUND,
   540	// proof-backed no_match limitation belongs, without any change to
   541	// resolveTerminalStatus's control flow or callers.
   542	//
   543	// No path today attaches such a proof to a resolution -- typed exact
   544	// readers, canonical basename projection, and per-key completeness tracking
   545	// are all later phases of the same architecture (§21 Phase 1-6) -- so every
   546	// ORDINARY empty pool takes the unproven branch below.
   547	//
   548	// CHAOS-4077 is this seam's first real branch, ahead of Phase 6: a
   549	// never-projected org is not "retrieval ran and found nothing" at all, so
   550	// it gets its own accurate wording rather than borrowing the unproven
   551	// one's (false, for this cause) claim that a search happened.
   552	func noMatchLimitationForEmptyPool(resolution *SubjectResolution) string {
   553		if resolution != nil && resolution.GraphNotProjected {
   554			return noMatchLimitationGraphNotProjected
   555		}
   556		return noMatchLimitationUnproven
   557	}
   558	
   559	// terminalVersions builds the version set for a model-free terminal result:
   560	// the synthesizer's static versions when it can report them (see
   561	// ResultVersionProvider), Engine's own service/contract versions, and the
   562	// "unwired" placeholder for everything only a model receipt could supply.
   563	func (e *Engine) terminalVersions() VersionSet {
   564		var versions VersionSet
   565		if provider, ok := e.synthesizer.(ResultVersionProvider); ok {
   566			versions = provider.StaticResultVersions()
   567		}
   568		versions.ServiceVersion = nonEmptyVersion(versions.ServiceVersion, e.serviceVersion)
   569		versions.ContractVersion = InvestigationResultSchemaV1
   570		versions.Backend = nonEmptyVersion(versions.Backend, "")
   571		versions.ProjectionVersion = nonEmptyVersion(versions.ProjectionVersion, "")
   572		versions.QueryVersion = nonEmptyVersion(versions.QueryVersion, "")
   573		versions.CanonicalServiceVersion = nonEmptyVersion(versions.CanonicalServiceVersion, "")
   574		versions.InterpretationVersion = nonEmptyVersion(versions.InterpretationVersion, "")
   575		versions.SynthesisVersion = nonEmptyVersion(versions.SynthesisVersion, "")
   576		versions.ModelIdentity = nonEmptyVersion(versions.ModelIdentity, "")
   577		return versions
   578	}

