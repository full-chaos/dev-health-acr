    66	// cases show zero interpreter/graph/fact/synthesis calls".
    67	func TestWindowGate_ExplicitUnconfirmed_InterceptsBeforeInterpret(t *testing.T) {
    68		t.Parallel()
    69		interpreter := &countingInterpreter{interpretation: bootstrapInterpretation()}
