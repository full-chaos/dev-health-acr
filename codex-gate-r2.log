    42				t.Fatalf("ReadFacts called with %#v -- a gated request must never reach the canonical fact read", request)
    43				return CanonicalFactBundle{}, nil
    44			}),
    45			Synthesizer: synthesizerFunc(func(context.Context, storage.Principal, SynthesisInput) (InvestigationResult, error) {
    46				t.Fatal("Synthesize called -- a gated request must never reach synthesis")
    47				return InvestigationResult{}, nil
    48			}),
