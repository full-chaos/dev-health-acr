    16	// CHAOS-4234: the class-default window gate (regime A) used to return a
    17	// window-ONLY disclosure because ResolveSubjects never ran under it
    18	// (CHAOS-4118 option (a)). The two kiac replicates of record showed
    19	// 45/50 and 43/48 positive-arm expected_kind offer misses were regime-A
    20	// rows with no candidate pool at all. The ruling (team-lead, 2026-08-24):
    21	// run ResolveSubjects in an OFFERS-ONLY mode under the gate, keep its
    22	// StructureOfferMaterial, discard every commit-bearing output, and
    23	// compose kind/handle/candidate offers BESIDE the window offer. Offers
    24	// minted under an inferred window are non-decisive disclosure, the same
    25	// class as the window offer itself -- the CHAOS-4040 bar (no committed
    26	// material under an inferred window) is untouched.
    27	
    28	func chaos4234GatedMaterial() StructureOfferMaterial {
    29		return StructureOfferMaterial{
    30			Missing: []StructureNeedKind{
    31				contractsv1.ContextFabricStructureNeedExpectedKind,
    32				contractsv1.ContextFabricStructureNeedSubjectHandle,
    33			},
    34			KindOptions: []KindOption{
    35				{Kind: SubjectPullRequest, Label: "a pull request", OfferSource: contractsv1.ContextFabricStructureOfferEngine},
    36				{Kind: SubjectWorkItem, Label: "a work item", OfferSource: contractsv1.ContextFabricStructureOfferEngine},
    37			},
    38			HandleOptions: []HandleOption{
    39				{Kind: SubjectPullRequest, PatternID: "pull_request_number", Value: "532", SourceColumn: "number", Label: "pull request #532", OfferSource: contractsv1.ContextFabricStructureOfferEngine},
    40			},
    41		}
    42	}
    43	
    44	// chaos4234GatedGraph returns a fake whose ResolveSubjects would COMMIT a
    45	// subject if its output were honoured -- so a gated result that carries
    46	// no committed material proves the engine discarded the resolution,
    47	// rather than proving the fake had nothing to commit.
    48	func chaos4234GatedGraph() *acceptanceGraphReader {
    49		return &acceptanceGraphReader{
    50			resolution: SubjectResolution{
    51				Candidates: []SubjectCandidate{{Subject: acceptanceProject(), Confidence: 0.99}},
    52				Committed:  []SubjectRef{acceptanceProject()},
    53			},
    54			context:  emptyGraphContext(),
    55			material: chaos4234GatedMaterial(),
    56		}
    57	}
    58	
    59	func TestCHAOS4234_ClassDefaultGate_ComposesKindAndHandleOffersBesideTheWindowOffer(t *testing.T) {
    60		t.Parallel()
    61		interpreter := &countingInterpreter{interpretation: bootstrapInterpretation()}
    62		graph := chaos4234GatedGraph()
    63		store := &staticResultStore{results: map[string]InvestigationResult{}}
    64		telemetry := &recordingTelemetry{}
    65		engine := buildWindowGateEngineWithTelemetry(t, interpreter, graph, store, telemetry)
    66	
    67		request := validInvestigationRequest() // no EvidenceWindow -- class-default gate applies
    68	
    69		result, err := engine.Investigate(context.Background(), acceptancePrincipal(), request)
    70		if err != nil {
    71			t.Fatalf("Investigate() error = %v, want a confirmation-required result", err)
    72		}
    73		if result.Status != InvestigationClarificationRequired {
    74			t.Fatalf("Status = %q, want clarification_required: the window gate still holds", result.Status)
    75		}
    76		if graph.resolveCalls != 1 {
    77			t.Fatalf("graph.resolveCalls = %d, want exactly 1: the offers-only resolve under the gate", graph.resolveCalls)
    78		}
    79		if graph.discoverCalls != 0 {
    80			t.Fatalf("graph.discoverCalls = %d, want 0: the gate still stops everything past subject resolution", graph.discoverCalls)
    81		}
    82		if len(result.SubjectResolution.Committed) != 0 || len(result.SubjectResolution.Candidates) != 0 {
    83			t.Fatalf("SubjectResolution = %#v, want NO committed material and NO candidates under the gate, even though the graph would have committed %q", result.SubjectResolution, acceptanceProject().CanonicalID)
    84		}
    85		if result.WindowClarification == nil || len(result.WindowClarification.Options) == 0 {
    86			t.Fatal("WindowClarification is nil or empty, want the window offer to survive unchanged")
    87		}
    88		if result.StructureNeeds == nil {
    89			t.Fatal("StructureNeeds is nil, want window + kind + handle disclosure")
    90		}
