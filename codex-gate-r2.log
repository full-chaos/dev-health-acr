    12	)
    13	
    14	// CHAOS-4085 / CHAOS-4089 -- SINK-LEVEL telemetry tests.
    15	//
    16	// THE LESSON THIS FILE EXISTS TO ENFORCE: a field existing on a telemetry
    17	// struct, and being populated by the code that builds it, must NEVER again
    18	// pass for that field reaching an operator.
    19	//
    20	// CHAOS-4085's trace addition shipped with the CommitBasis/TiedStatisticalTop
    21	// fields defined, populated at every emission site, and covered by tests --
    22	// and none of it reached production, because the production slog sink simply
    23	// did not log them and no test looked at the sink. Worse, the whole commit
    24	// retraction event was invisible: CommitAffirmationTelemetry is an OPTIONAL
    25	// interface, and nothing in production implemented it, so every retraction
    26	// failed a type assertion and disappeared. Both were caught only by a
    27	// retroactive codex pass.
    28	//
    29	// The shape of the miss is what matters: every test involved read the
    30	// telemetry value DIRECTLY through an in-memory double, which is precisely
    31	// the kind of test that cannot observe "nothing downstream consumes this".
    32	// So the tests below deliberately assert against the PRODUCTION sink's real
    33	// output bytes -- the log line an operator would actually receive -- rather
    34	// than against any struct field.
    35	//
    36	// If you add a field to a telemetry or trace event, add its assertion here
    37	// too. A test that reads the field off the struct proves nothing about
    38	// whether anyone will ever see it.
    39	
    40	// captureSlogJSON runs emit against a JSON slog logger at Debug level and
    41	// returns the decoded records, so an assertion can name the exact key an
    42	// operator would grep for.
    43	func captureSlogJSON(t *testing.T, emit func(*slog.Logger)) []map[string]any {
    44		t.Helper()
    45		var buffer bytes.Buffer
    46		logger := slog.New(slog.NewJSONHandler(&buffer, &slog.HandlerOptions{Level: slog.LevelDebug}))
    47		emit(logger)
    48	
    49		records := make([]map[string]any, 0, 2)
    50		for _, line := range strings.Split(strings.TrimSpace(buffer.String()), "\n") {
    51			if strings.TrimSpace(line) == "" {
    52				continue
    53			}
    54			record := map[string]any{}
    55			if err := json.Unmarshal([]byte(line), &record); err != nil {
    56				t.Fatalf("telemetry emitted a line that is not valid JSON: %v (%q)", err, line)
    57			}
    58			records = append(records, record)
    59		}
    60		return records
    61	}
    62	
    63	// TestChaos4085_ProductionTelemetryEmitsARetraction is the sink-level pin
    64	// for the hole this file's header describes: SlogEngineTelemetry must
    65	// actually implement CommitAffirmationTelemetry, and the record must carry
    66	// every field the outcome does.
    67	//
    68	// The interface assertion is the load-bearing half. recordCommitAffirmation
    69	// reaches the sink through an optional type assertion, so a production
    70	// telemetry that merely FAILS to implement this method is not a compile
    71	// error anywhere -- it is a silent, total loss of the signal. That is
    72	// exactly what shipped.
    73	func TestChaos4085_ProductionTelemetryEmitsARetraction(t *testing.T) {
    74		// Compile-time proof that the production sink satisfies the optional
    75		// interface. If someone removes the method, this line fails to build
    76		// instead of the signal quietly disappearing at runtime.
    77		var _ CommitAffirmationTelemetry = SlogEngineTelemetry{}
    78	
    79		records := captureSlogJSON(t, func(logger *slog.Logger) {
    80			NewSlogEngineTelemetry(logger).RecordCommitAffirmationRetraction(
    81				context.Background(),
    82				storage.Principal{OrgID: "org_sink_test"},
    83				CommitAffirmationOutcome{
    84					Basis:                CommitBasisStatistical,
    85					SubjectKind:          SubjectWorkItem,
    86					WinningMechanism:     "lexical",
    87					ProvisionalCommitted: 2,
    88					FinalCommitted:       1,
    89				},
    90			)
    91		})
    92	
    93		if len(records) != 1 {
    94			t.Fatalf("a retraction must produce exactly one log record, got %d", len(records))
    95		}
    96		record := records[0]
    97		for key, want := range map[string]any{
    98			"org_id":            "org_sink_test",
    99			"commit_basis":      string(CommitBasisStatistical),
   100			"subject_kind":      string(SubjectWorkItem),
   101			"winning_mechanism": "lexical",
   102		} {
   103			if got, ok := record[key]; !ok || got != want {
   104				t.Fatalf("record[%q] = %v (present=%v), want %v -- an operator greps for this key", key, got, ok, want)
   105			}
   106		}
   107		// JSON numbers decode as float64.
   108		for key, want := range map[string]float64{"provisional_committed": 2, "final_committed": 1} {
   109			if got, ok := record[key].(float64); !ok || got != want {
   110				t.Fatalf("record[%q] = %v, want %v", key, record[key], want)
   111			}
   112		}
   113	}
   114	
   115	// TestChaos4085_RetractionTelemetryLeaksNoIdentityAndStaysAtWarn holds the
   116	// content-safety line every method on this sink already holds, and pins the
   117	// level.
   118	//
   119	// The oracle is an ALLOW-LIST, not a denylist (codex pre-merge review, LOW):
   120	// a denylist of forbidden substrings only catches the leaks someone thought
   121	// of, so a future field named subject_id or subject carrying a canonical
   122	// value would sail through one. Requiring every key to be explicitly
   123	// permitted inverts that -- a new field fails this test by default and has
   124	// to be argued for. Given this file exists because a telemetry gap shipped
   125	// unnoticed, the default must be "fail" rather than "pass unless it looks
   126	// suspicious".
   127	func TestChaos4085_RetractionTelemetryLeaksNoIdentityAndStaysAtWarn(t *testing.T) {
   128		records := captureSlogJSON(t, func(logger *slog.Logger) {
   129			NewSlogEngineTelemetry(logger).RecordCommitAffirmationRetraction(
   130				context.Background(),
   131				storage.Principal{OrgID: "org_sink_test"},
   132				CommitAffirmationOutcome{
   133					Basis: CommitBasisUnknown, SubjectKind: SubjectRepository,
   134					WinningMechanism: "vector", ProvisionalCommitted: 1, FinalCommitted: 0,
   135				},
   136			)
   137		})
   138		if len(records) != 1 {
   139			t.Fatalf("expected one record, got %d", len(records))
   140		}
   141		record := records[0]
   142	
   143		// Every key this record is permitted to carry. slog's own envelope
   144		// (time/level/msg) plus the org id, the closed enums, and the counts.
   145		// request_id is permitted but only appears when ctx carries one.
   146		permitted := map[string]struct{}{
   147			"time": {}, "level": {}, "msg": {},
   148			"org_id": {}, "commit_basis": {}, "subject_kind": {},
   149			"winning_mechanism": {}, "provisional_committed": {}, "final_committed": {},
   150			"request_id": {},
   151		}
   152		for key := range record {
   153			if _, ok := permitted[key]; !ok {
   154				t.Fatalf("retraction telemetry emits unpermitted key %q -- if this field is genuinely safe, add it to the allow-list deliberately", key)
   155			}
   156		}
   157	
   158		// The VALUES must be closed-vocabulary too: an allow-listed key holding
   159		// a canonical id would defeat the key check.
   160		if got := record["subject_kind"]; got != string(SubjectRepository) {
   161			t.Fatalf("subject_kind = %v, want the closed kind enum %q", got, SubjectRepository)
   162		}
   163		if got := record["commit_basis"]; got != string(CommitBasisUnknown) {
   164			t.Fatalf("commit_basis = %v, want the closed basis enum (empty for unknown)", got)
   165		}
   166	
   167		// WARN, pinned: a retraction is a designed outcome, but a RATE change in
   168		// it is the signal that retrieval quality or synthesis grounding moved.
   169		// Demoting it to INFO would bury that under the reuse-outcome stream,
   170		// and nothing else in the suite would notice.
   171		if got := record["level"]; got != "WARN" {
   172			t.Fatalf("level = %v, want WARN -- see RecordCommitAffirmationRetraction's own doc comment for why", got)
   173		}
   174	}
   430			t.Fatalf("Investigate: %v", err)
   431		}
   432		if len(telemetry.synthesisStatusOverrides) != 0 {
   433			t.Fatalf("an unoverridden answer emitted %d events", len(telemetry.synthesisStatusOverrides))
   434		}
   435	}
   436	
   437	// TestChaos4098_ProductionTelemetryEmitsAnOverride is the SINK-level pin --
   438	// see chaos4085_telemetry_sink_test.go's own header for why a struct-level
   439	// assertion is not enough. This branch's signal must survive as real bytes
   440	// an operator receives.
   441	//
   442	// The compile-time proof is the load-bearing half here too, but in the
   443	// opposite direction from CHAOS-4085's: RecordSynthesisStatusOverride is
   444	// declared on EngineTelemetry itself, so a sink that drops it cannot build.
   445	// The assertion states that dependency rather than leaving it implicit.
   446	func TestChaos4098_ProductionTelemetryEmitsAnOverride(t *testing.T) {
   447		var _ EngineTelemetry = SlogEngineTelemetry{}
   448	
   449		records := captureSlogJSON(t, func(logger *slog.Logger) {
   450			NewSlogEngineTelemetry(logger).RecordSynthesisStatusOverride(
   451				context.Background(),
   452				storage.Principal{OrgID: "org_sink_test"},
   453				SynthesisStatusOverrideOutcome{
   454					From: InvestigationClarificationRequired, To: InvestigationNoMatch,
   455					Reason: SynthesisStatusOverrideClarificationUnavailable, CommittedCount: 1,
   456				},
   457			)
   458		})
   459		if len(records) != 1 {
   460			t.Fatalf("an override must produce exactly one log record, got %d", len(records))
   461		}
   462		record := records[0]
   463		for key, want := range map[string]any{
   464			"org_id":      "org_sink_test",
   465			"from_status": string(InvestigationClarificationRequired),
   466			"to_status":   string(InvestigationNoMatch),
   467			"reason":      string(SynthesisStatusOverrideClarificationUnavailable),
   468		} {
   469			if got, ok := record[key]; !ok || got != want {
   470				t.Fatalf("record[%q] = %v (present=%v), want %v -- an operator greps for this key", key, got, ok, want)
   471			}
   472		}
   473		if got, ok := record["committed_count"].(float64); !ok || got != 1 {
   474			t.Fatalf("record[\"committed_count\"] = %v, want 1", record["committed_count"])
   475		}
   476	}
   477	
   478	// TestChaos4098_OverrideTelemetryLeaksNoIdentityAndStaysAtWarn mirrors
   479	// CHAOS-4085's allow-list oracle: a new field fails by default and has to
   480	// be argued for.
   481	func TestChaos4098_OverrideTelemetryLeaksNoIdentityAndStaysAtWarn(t *testing.T) {
   482		records := captureSlogJSON(t, func(logger *slog.Logger) {
   483			NewSlogEngineTelemetry(logger).RecordSynthesisStatusOverride(
   484				context.Background(),
   485				storage.Principal{OrgID: "org_sink_test"},
   486				SynthesisStatusOverrideOutcome{
   487					From: InvestigationClarificationRequired, To: InvestigationNoMatch,
   488					Reason: SynthesisStatusOverrideClarificationUnavailable, CommittedCount: 0,
   489				},
   490			)
   491		})
   492		if len(records) != 1 {
   493			t.Fatalf("expected one record, got %d", len(records))
   494		}
   495		record := records[0]
   496		permitted := map[string]struct{}{
   497			"time": {}, "level": {}, "msg": {},
   498			"org_id": {}, "from_status": {}, "to_status": {}, "reason": {},
   499			"committed_count": {}, "request_id": {},
   500		}
   501		for key := range record {
   502			if _, ok := permitted[key]; !ok {
   503				t.Fatalf("override telemetry emits unpermitted key %q -- if this field is genuinely safe, add it to the allow-list deliberately", key)
   504			}
   505		}
   506		if got := record["level"]; got != "WARN" {
   507			t.Fatalf("level = %v, want WARN -- see RecordSynthesisStatusOverride's own doc comment for why", got)
