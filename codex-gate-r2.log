    88	func (e *Engine) consultPriorStructureOffers(ctx context.Context, principal storage.Principal, entries []StructurePriorEntry, material StructureOfferMaterial) StructureOfferMaterial {
    89		if len(entries) == 0 || len(material.Missing) == 0 {
    90			return material
    91		}
    92		missing := map[contractsv1.ContextFabricStructureNeedKind]bool{}
    93		for _, m := range material.Missing {
    94			missing[m] = true
    95		}
    96		material = e.mergePriorKindOffers(ctx, principal, entries, missing, material)
    97		material = e.mergePriorHandleOffers(ctx, principal, entries, missing, material)
    98		return material
    99	}
   100	
   101	func (e *Engine) mergePriorKindOffers(ctx context.Context, principal storage.Principal, entries []StructurePriorEntry, missing map[contractsv1.ContextFabricStructureNeedKind]bool, material StructureOfferMaterial) StructureOfferMaterial {
   102		if !missing[contractsv1.ContextFabricStructureNeedExpectedKind] {
   103			return material
   104		}
   105		var sawCandidate, offered, revoked bool
   106		for _, entry := range entries {
   107			if entry.Member != contractsv1.ContextFabricStructureNeedExpectedKind {
   108				continue
   109			}
   110			sawCandidate = true
   111			if entry.Revoked {
   112				revoked = true
   113				continue
   114			}
   115			kind := contractsv1.ContextFabricSubjectKind(entry.Value)
   116			label, ok := structurePriorKindLabel(kind)
   117			if !ok {
   118				continue
   119			}
   120			material.KindOptions = append(material.KindOptions, contractsv1.ContextFabricKindOption{
   121				Label: label, Kind: kind,
   122				OfferSource:    contractsv1.ContextFabricStructureOfferPrior,
   123				PriorVersionID: strconv.FormatInt(entry.Version, 10), PriorEntryID: entry.EntryID,
   124			})
   125			offered = true
   126		}
   127		e.recordPriorConsultOutcome(ctx, principal, contractsv1.ContextFabricStructureNeedExpectedKind, sawCandidate, offered, revoked)
   128		return material
   129	}
   130	
   131	func (e *Engine) mergePriorHandleOffers(ctx context.Context, principal storage.Principal, entries []StructurePriorEntry, missing map[contractsv1.ContextFabricStructureNeedKind]bool, material StructureOfferMaterial) StructureOfferMaterial {
   132		if !missing[contractsv1.ContextFabricStructureNeedSubjectHandle] {
   133			return material
   134		}
   135		var sawCandidate, offered, revoked bool
   136		for _, entry := range entries {
   137			if entry.Member != contractsv1.ContextFabricStructureNeedSubjectHandle {
   138				continue
   139			}
   140			sawCandidate = true
   141			if entry.Revoked {
   142				revoked = true
   143				continue
   144			}
   145			if e.priorHandleGrammarChecker == nil {
   146				continue
   147			}
   148			sourceColumn, ok := e.priorHandleGrammarChecker(entry.Kind, entry.PatternID, entry.Value)
   149			if !ok {
   150				continue
   151			}
   152			label, ok := structurePriorHandleLabel(entry.Kind, entry.Value)
   153			if !ok {
   154				continue
   155			}
