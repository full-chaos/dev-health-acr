    36	func buildWindowGateEngine(t *testing.T, interpreter QuestionInterpreter, graph *acceptanceGraphReader, results InvestigationResultStore) *Engine {
    37		t.Helper()
    38		engine, err := NewEngine(EngineDependencies{
