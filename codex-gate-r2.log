    21	// countingInterpreter counts Interpret calls and returns a fixed
    22	// interpretation -- used to prove explicit-unconfirmed gating (gate 1)
    23	// happens BEFORE Interpret ever runs (calls stays 0), and that
    24	// class-default gating (gate 2) happens AFTER it (calls reaches exactly 1,
    25	// never more).
    26	type countingInterpreter struct {
    27		interpretation InterpretedQuestion
    28		calls          int
    29	}
    30	
    31	func (c *countingInterpreter) Interpret(context.Context, storage.Principal, InvestigationRequest) (InterpretedQuestion, error) {
    32		c.calls++
    33		return c.interpretation, nil
    34	}
