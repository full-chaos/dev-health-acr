      "required": [
        "receipt_id",
        "option_id",
        "label"
      ],
      "allOf": [
        {
          "description": "CHAOS-3900 W1: a non-all_time relative_id's bounds are the FROZEN offer-time computation, so both must be present -- mirrors window.validate() lines 33-52's non-all_time branch (via WindowOption.Validate's own additional relative_id-non-all_time-requires-bounds check, validate_context_fabric_window.go:115-117).",
          "if": {
            "properties": {
              "relative_id": {
                "not": {
                  "const": "all_time"
                }
              }
            },
            "required": [
              "relative_id"
            ]
          },
          "then": {
            "required": [
              "start",
              "end"
            ]
          }
        },
        {
          "description": "CHAOS-3900 W1 (codex round 7): all_time forbids any bound -- mirrors window.validate() lines 37-40, which the original if/then above never encoded because its own 'if' matches only the non-all_time direction. Deliberately does NOT also fire when relative_id is absent: an option with no relative_id and BOTH bounds present is a legal explicit-bounds-only shape (window.validate() lines 43-52), which this clause must not forbid.",
          "if": {
            "properties": {
              "relative_id": {
                "const": "all_time"
              }
            },
            "required": [
              "relative_id"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "start"
                  ]
                },
                {
                  "required": [
                    "end"
                  ]
                }
              ]
            }
          }
        }
      ],
      "anyOf": [
        {
          "description": "CHAOS-3900 W1 (codex round 7): baseline presence -- an option with neither relative_id nor any bound satisfies neither if/then above (both require relative_id to fire) and so previously passed schema validation despite window.validate() lines 43-47 rejecting it ('requires a relative_id or explicit bounds').",
          "required": [
            "relative_id"
          ]
        },
        {
          "required": [
            "start",
            "end"
          ]
        }
      ],
      "not": {
        "description": "CHAOS-3900 W1 (codex round 7): completeness guard, identical to RequestedEvidenceWindow's own -- the anyOf above is satisfied by a relative_id present alongside only ONE bound (it does not check the bound pair for completeness), which window.validate() line 49 rejects regardless of relative_id. Forbids exactly-one-of-start/end unconditionally.",
        "anyOf": [
          {
            "required": [
              "start"
            ],
            "not": {
              "required": [
                "end"
              ]
            }
          },
          {
            "required": [
              "end"
            ],
            "not": {
              "required": [
                "start"
              ]
            }
          }
        ]
      }
