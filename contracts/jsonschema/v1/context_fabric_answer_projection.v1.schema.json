{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fullchaos.dev/acr/v1/context_fabric_answer_projection.v1.schema.json",
  "title": "ACR Context Fabric Answer Projection v1",
  "description": "Bounded consumer projection of a context_fabric_investigation_result.v1 (CHAOS-3746). Produced by exactly one function so that the hosted API and the MCP sidecar cannot diverge. The projection SELECTS and DROPS: it never rewrites, re-ranks, re-judges, or re-words. direct_judgment, current_state, and every retained driver standing and category are copied verbatim, so consumer-specific truncation can never change the underlying judgment. Every drop is declared in projection_budget. result_id identifies the canonical result: a consumer that needs anything dropped fetches that result rather than asking for a fatter answer. Every identifier is opaque and must not be parsed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "context_fabric_answer_projection.v1"
    },
    "result_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "degraded",
        "clarification_required",
        "no_match"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "reused": {
      "type": "boolean",
      "description": "CHAOS-3782: true when the answer was served from the immutable result store rather than a fresh investigation. When true, result_id and generated_at name the reused result, not this request."
    },
    "direct_judgment": {
      "type": "string",
      "maxLength": 4000
    },
    "current_state": {
      "type": "string",
      "maxLength": 4000
    },
    "strongest_pressures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "committed_subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SubjectRef"
      },
      "maxItems": 250,
      "uniqueItems": true
    },
    "clarification": {
      "$ref": "#/$defs/ProjectedClarification"
    },
    "cohort": {
      "$ref": "#/$defs/ProjectedCohort"
    },
    "principal_drivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProjectedDriver"
      },
      "maxItems": 50
    },
    "key_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProjectedFact"
      },
      "maxItems": 250
    },
    "coverage_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProjectedCoverage"
      },
      "maxItems": 100
    },
    "temporal": {
      "$ref": "#/$defs/TemporalLabel"
    },
    "coverage_partial": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "evidence_ref_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 256,
        "pattern": "^[^|]*$"
      },
      "maxItems": 500,
      "uniqueItems": true
    },
    "subject_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BoundSubjectReceipt"
      },
      "maxItems": 50
    },
    "versions": {
      "$ref": "#/$defs/VersionSet"
    },
    "projection_budget": {
      "$ref": "#/$defs/ProjectionBudget"
    },
    "effective_evidence_window": {
      "$ref": "#/$defs/EffectiveEvidenceWindow"
    },
    "window_clarification": {
      "$ref": "#/$defs/WindowClarification"
    },
    "structure_needs": {
      "$ref": "#/$defs/StructureNeeds"
    },
    "confirmed_structure": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConfirmedStructureEntry"
      },
      "maxItems": 4
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "request_id",
    "generated_at",
    "status",
    "question",
    "reused",
    "direct_judgment",
    "current_state",
    "strongest_pressures",
    "committed_subjects",
    "principal_drivers",
    "key_facts",
    "coverage_summary",
    "coverage_partial",
    "limitations",
    "warnings",
    "evidence_ref_ids",
    "subject_receipts",
    "versions",
    "projection_budget"
  ],
  "$defs": {
    "SubjectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "organization",
            "team",
            "project",
            "repository",
            "work_item",
            "pull_request",
            "deployment",
            "incident",
            "document",
            "decision",
            "episode",
            "metric",
            "pull_request_review",
            "ci_pipeline_run",
            "work_item_ref"
          ]
        },
        "canonical_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "canonical_id",
        "label"
      ]
    },
    "ScalarValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "string": {
          "type": "string",
          "maxLength": 4000
        },
        "integer": {
          "type": "integer"
        },
        "number": {
          "type": "number"
        },
        "boolean": {
          "type": "boolean"
        },
        "null": {
          "const": true
        }
      },
      "oneOf": [
        {
          "required": [
            "string"
          ]
        },
        {
          "required": [
            "integer"
          ]
        },
        {
          "required": [
            "number"
          ]
        },
        {
          "required": [
            "boolean"
          ]
        },
        {
          "required": [
            "null"
          ]
        }
      ]
    },
    "VersionSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "backend_version": {
          "type": "string",
          "maxLength": 256
        },
        "projection_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "query_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "interpretation_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "synthesis_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "canonical_service_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 513,
          "description": "CHAOS-3782: the provider/model that produced this result's synthesis, e.g. \"openai-compatible/gpt-5-nano\". Never a bare vendor name. Optional: rows persisted before this field existed (or by any writer with answer reuse disabled) omit it entirely; absence never blocks reading an existing result, and never makes that result reuse-eligible either (reuse also requires question_hash, absent on the same rows for the same reason). maxLength is provider (<=256) + \"/\" + model (<=256) = 513, not the 256 shared by every other field here -- those are short deployment/prompt version tokens ACR itself controls."
        }
      },
      "required": [
        "service_version",
        "contract_version",
        "backend",
        "projection_version",
        "query_version",
        "interpretation_version",
        "synthesis_version",
        "canonical_service_version"
      ]
    },
    "ProjectedCandidate": {
      "description": "One ambiguity option. receipt_id is the opaque handle a caller returns to commit this choice on the next turn.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "subject": {
          "$ref": "#/$defs/SubjectRef"
        },
        "state": {
          "type": "string",
          "enum": [
            "committed",
            "proposed",
            "ambiguous",
            "unresolved"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "match_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "receipt_id",
        "subject",
        "state",
        "confidence",
        "match_reasons"
      ]
    },
    "ProjectedClarification": {
      "description": "Present only when status is clarification_required.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "maxLength": 2000
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectedCandidate"
          },
          "maxItems": 50
        }
      },
      "required": [
        "candidates"
      ]
    },
    "ProjectedCohortMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "$ref": "#/$defs/SubjectRef"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "inclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "evidence_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "^[^|]*$"
          },
          "maxItems": 500,
          "uniqueItems": true
        }
      },
      "required": [
        "subject",
        "rank",
        "inclusion_reasons"
      ]
    },
    "ProjectedCohort": {
      "description": "Subjectless cohort answer. total reports the canonical member count before projection, so a caller always sees the true size even when members is truncated. complete is the engine's statement about the cohort it discovered, never a statement about this projection.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "organization",
            "team",
            "project",
            "repository",
            "work_item",
            "pull_request",
            "deployment",
            "incident",
            "document",
            "decision",
            "episode",
            "metric",
            "pull_request_review",
            "ci_pipeline_run",
            "work_item_ref"
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "complete": {
          "type": "boolean"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectedCohortMember"
          },
          "maxItems": 250
        }
      },
      "required": [
        "kind",
        "total",
        "rationale",
        "complete",
        "members"
      ]
    },
    "ProjectedDriver": {
      "description": "One driver judgment, narrowed to what a bounded consumer needs to state and defend it. standing and category are copied verbatim from the canonical result: driver standing IS the judgment, so a projection that promoted or demoted one would change the answer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "standing": {
          "type": "string",
          "enum": [
            "principal",
            "contributing",
            "symptom",
            "context",
            "withheld"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "status",
            "actual_completion",
            "work",
            "blockers",
            "reviews",
            "continuous_integration",
            "deployments",
            "incidents",
            "health",
            "workload",
            "investment",
            "readiness",
            "operational_deficiency",
            "source_health",
            "relationship",
            "narrative"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "qualification": {
          "type": "string",
          "maxLength": 2000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "pattern": "^[^|]*$"
          },
          "maxItems": 500,
          "uniqueItems": true
        },
        "claimed_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 250,
          "uniqueItems": true
        }
      },
      "required": [
        "driver_id",
        "standing",
        "category",
        "title",
        "summary",
        "confidence",
        "evidence_ref_ids"
      ]
    },
    "ProjectedFact": {
      "description": "A claimed fact a retained driver cites, carried at value level so a consumer can show the canonical observation behind a judgment rather than only prose about it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "enum": [
            "identity",
            "membership",
            "status",
            "actual_completion",
            "work",
            "blockers",
            "required_children",
            "pull_requests",
            "reviews",
            "continuous_integration",
            "deployments",
            "incidents",
            "metrics",
            "health",
            "workload",
            "investment",
            "readiness",
            "operational_deficiencies",
            "source_health",
            "evidence"
          ]
        },
        "subject": {
          "$ref": "#/$defs/SubjectRef"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "$ref": "#/$defs/ScalarValue"
        }
      },
      "required": [
        "claim_id",
        "kind",
        "subject",
        "field",
        "value"
      ]
    },
    "ProjectedCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "stale",
            "unavailable",
            "unconfigured",
            "unauthorized",
            "no_data",
            "truncated",
            "conflicted",
            "not_applicable",
            "pruned"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "source",
        "state"
      ]
    },
    "TemporalLabel": {
      "type": "object",
      "additionalProperties": false,
      "description": "The time an answer actually speaks for on a historical time axis (CHAOS-3781, AC-3781-2). Absent on the current axis. Effective is always narrower than or equal to requested; an answer may speak for less time than was asked about, never more.",
      "properties": {
        "requested": {
          "allOf": [
            {
              "$ref": "#/$defs/TimeContext"
            },
            {
              "properties": {
                "axis": {
                  "enum": [
                    "valid_time",
                    "observed_time",
                    "range"
                  ]
                }
              }
            }
          ]
        },
        "effective": {
          "allOf": [
            {
              "$ref": "#/$defs/TimeContext"
            },
            {
              "properties": {
                "axis": {
                  "enum": [
                    "valid_time",
                    "observed_time",
                    "range"
                  ]
                }
              }
            }
          ]
        },
        "grain": {
          "type": "string",
          "enum": [
            "instant",
            "day",
            "none"
          ]
        },
        "coverage_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "requested",
        "effective",
        "grain",
        "coverage_complete"
      ]
    },
    "TimeContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "current",
            "valid_time",
            "observed_time",
            "range"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_window": {
          "description": "CHAOS-3900 W1: legal ONLY when axis is current -- every other axis's own as_of/start/end already IS the window that axis answers for.",
          "$ref": "#/$defs/RequestedEvidenceWindow"
        }
      },
      "required": [
        "axis"
      ],
      "oneOf": [
        {
          "properties": {
            "axis": {
              "const": "current"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "as_of"
                ]
              },
              {
                "required": [
                  "start"
                ]
              },
              {
                "required": [
                  "end"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "axis": {
              "enum": [
                "valid_time",
                "observed_time"
              ]
            }
          },
          "required": [
            "as_of"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "start"
                ]
              },
              {
                "required": [
                  "end"
                ]
              },
              {
                "required": [
                  "evidence_window"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "axis": {
              "const": "range"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "as_of"
                ]
              },
              {
                "required": [
                  "evidence_window"
                ]
              }
            ]
          }
        }
      ]
    },
    "BoundSubjectReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "receipt_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        }
      },
      "required": [
        "result_id",
        "receipt_id"
      ]
    },
    "ProjectionBudget": {
      "description": "Declares what the projection dropped. truncated is true if and only if at least one omitted count is non-zero or full_result_omitted is set. Silent truncation is a defect: a caller that cannot see what was omitted cannot tell a short answer from a complete one. The counters added after this contract's first shape (limitations, warnings, coverage, reasons, values_clamped) are OPTIONAL: additive-optional means optional, so a payload produced before they existed still validates and an absent counter reads as zero. ACR itself always emits them.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "truncated": {
          "type": "boolean"
        },
        "drivers_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "withheld_drivers_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "cohort_members_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "facts_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "candidates_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_refs_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "limitations_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "warnings_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "reasons_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "values_clamped": {
          "type": "integer",
          "minimum": 0
        },
        "full_result_omitted": {
          "type": "boolean"
        }
      },
      "required": [
        "truncated",
        "drivers_omitted",
        "withheld_drivers_omitted",
        "cohort_members_omitted",
        "facts_omitted",
        "candidates_omitted",
        "evidence_refs_omitted",
        "full_result_omitted"
      ]
    },
    "RequestedEvidenceWindow": {
      "description": "CHAOS-3900 W1: the caller's own evidence-window intent. Structurally cannot carry provenance/class/confidence -- those are server-computed. RelativeID all_time requires start/end to both be absent; every other shape requires both.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "relative_id": {
          "$ref": "#/$defs/RelativeWindowID"
        }
      },
      "if": {
        "properties": {
          "relative_id": {
            "const": "all_time"
          }
        },
        "required": [
          "relative_id"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "start"
              ]
            },
            {
              "required": [
                "end"
              ]
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "relative_id"
          ]
        },
        {
          "required": [
            "start",
            "end"
          ]
        }
      ],
      "not": {
        "description": "CHAOS-3900 W1 (codex round 7): the anyOf above proves AT LEAST ONE of relative_id/start+end is present, but does not by itself forbid a partial bound alongside a relative_id (e.g. relative_id+start with no end) -- that shape satisfies the anyOf's first branch regardless of how incomplete the bounds are. This guard closes exactly that gap: whichever of start/end is present, the other must be too, matching validate_context_fabric_window.go's validate() line 49 (\"requires an ordered start and end\") for every non-all_time shape, independent of whether relative_id is also present.",
        "anyOf": [
          {
            "required": [
              "start"
            ],
            "not": {
              "required": [
                "end"
              ]
            }
          },
          {
            "required": [
              "end"
            ],
            "not": {
              "required": [
                "start"
              ]
            }
          }
        ]
