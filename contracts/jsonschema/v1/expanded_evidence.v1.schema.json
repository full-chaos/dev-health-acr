{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACR Expanded Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence",
    "resolved_at",
    "availability",
    "structured_fields"
  ],
  "properties": {
    "schema_version": {
      "const": "expanded_evidence.v1"
    },
    "evidence": {
      "$ref": "evidence_ref.v1.schema.json"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "availability": {
      "enum": [
        "available",
        "stale",
        "redacted",
        "deleted",
        "unauthorized"
      ]
    },
    "excerpt": {
      "type": "string",
      "maxLength": 1000
    },
    "structured_fields": {
      "type": "object",
      "additionalProperties": true
    },
    "redaction_reason": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "$id": "https://contracts.fullchaos.dev/acr/v1/expanded_evidence.v1.schema.json"
}
