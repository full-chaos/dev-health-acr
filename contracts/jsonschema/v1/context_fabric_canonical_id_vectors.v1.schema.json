{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fullchaos.dev/acr/v1/context_fabric_canonical_id_vectors.v1.schema.json",
  "title": "Context Fabric Canonical ID Vectors v1",
  "description": "Test vectors for the canonical subject ids the Context Fabric projector mints, generated by executing acr's own id builders (CHAOS-12230). A caller that names a subject by canonical id (requested_scope.subject_hints[].id, for example the Ask Dev page context) commits on that identity only when its id is byte-equal to the projected one; any other id falls back to label search. Each vector gives a natural key, named after its source columns, and the id the builder returns for it. A work_item or project key whose id would exceed 256 bytes is omitted by the producer: its vector carries omitted=true and no canonical_id, and a caller must then send no id. This is a generated test-vector artifact, not a wire payload; regenerate it with ACR_WRITE_CANONICAL_ID_VECTORS=1 go test ./internal/contextfabric/devhealthsource/ -run TestCanonicalIDVectorsMatchTheBuilders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vectors"
  ],
  "properties": {
    "schema_version": {
      "const": "context_fabric_canonical_id_vectors.v1"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Vector"
      }
    }
  },
  "$defs": {
    "Vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "natural_key"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "organization",
            "repository",
            "team",
            "pull_request",
            "work_item",
            "project"
          ]
        },
        "natural_key": {
          "type": "object"
        },
        "canonical_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "The id the builder returns for natural_key. Absent exactly when omitted is true."
        },
        "omitted": {
          "const": true,
          "description": "The producer omits this key's whole row: its id would exceed 256 bytes. Present only on work_item and project vectors."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "organization"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/KeptVector",
            "properties": {
              "natural_key": {
                "$ref": "#/$defs/OrganizationKey"
              },
              "canonical_id": {
                "pattern": "^organization:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "repository"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/KeptVector",
            "properties": {
              "natural_key": {
                "$ref": "#/$defs/RepositoryKey"
              },
              "canonical_id": {
                "pattern": "^repository:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "team"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/KeptVector",
            "properties": {
              "natural_key": {
                "$ref": "#/$defs/TeamKey"
              },
              "canonical_id": {
                "pattern": "^team:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pull_request"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/KeptVector",
            "properties": {
              "natural_key": {
                "$ref": "#/$defs/PullRequestKey"
              },
              "canonical_id": {
                "pattern": "^pull_request:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "work_item"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/KeptOrOmittedVector",
            "properties": {
              "natural_key": {
                "$ref": "#/$defs/WorkItemKey"
              },
              "canonical_id": {
                "pattern": "^work_item\\.v2:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "project"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/KeptOrOmittedVector",
            "properties": {
              "natural_key": {
                "$ref": "#/$defs/ProjectKey"
              },
              "canonical_id": {
                "pattern": "^project\\.v2:"
              }
            }
          }
        }
      ]
    },
    "KeptVector": {
      "description": "A vector whose kind is never omitted: it carries canonical_id and no omitted.",
      "required": [
        "canonical_id"
      ],
      "not": {
        "required": [
          "omitted"
        ]
      }
    },
    "KeptOrOmittedVector": {
      "description": "A vector of a kind the producer may omit: canonical_id, or omitted=true, never both.",
      "oneOf": [
        {
          "$ref": "#/$defs/KeptVector"
        },
        {
          "required": [
            "omitted"
          ],
          "not": {
            "required": [
              "canonical_id"
            ]
          }
        }
      ]
    },
    "OrganizationKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org_id"
      ],
      "properties": {
        "org_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RepositoryKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 1,
          "description": "repos.id, a UUID."
        }
      }
    },
    "TeamKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_id"
      ],
      "properties": {
        "team_id": {
          "type": "string",
          "minLength": 1,
          "description": "teams.id; may contain ':'."
        }
      }
    },
    "PullRequestKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "number"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 1,
          "description": "git_pull_requests.repo_id, a UUID."
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "git_pull_requests.number (UInt32), as a JSON integer; the id carries it in decimal."
        }
      }
    },
    "WorkItemKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "work_item_id"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 1,
          "description": "work_items.repo_id, a UUID; the zero UUID for a work item with no repository (Linear)."
        },
        "work_item_id": {
          "type": "string",
          "minLength": 1,
          "description": "work_items.work_item_id; may contain ':' and '%'."
        }
      }
    },
    "ProjectKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "project_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "projects.provider."
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "description": "projects.id; may contain ':' and '%'."
        }
      }
    }
  }
}
