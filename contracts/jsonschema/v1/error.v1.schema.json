{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACR Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "error.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "http_status",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "device_authorization_conflict",
            "invalid_token",
            "insufficient_scope",
            "feature_not_enabled",
            "repo_forbidden",
            "not_found",
            "rate_limited",
            "version_mismatch",
            "upstream_unavailable",
            "interpretation_rejected",
            "synthesis_rejected",
            "provider_error",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "http_status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "$id": "https://contracts.fullchaos.dev/acr/v1/error.v1.schema.json"
}
