{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACR Context Packet Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_item_id",
    "category",
    "claim_kind",
    "title",
    "summary",
    "why_included",
    "rule_id",
    "confidence",
    "severity",
    "rank",
    "validity_scope",
    "flags",
    "related_entities",
    "evidence_ref_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "context_packet_item.v1"
    },
    "packet_item_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "category": {
      "enum": [
        "state",
        "pressure",
        "cause",
        "evidence",
        "action"
      ]
    },
    "claim_kind": {
      "enum": [
        "observed",
        "inferred",
        "recommendation"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "why_included": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ]
    },
    "rank": {
      "type": "integer",
      "minimum": 0
    },
    "validity_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "maxLength": 512
        },
        "commit_sha": {
          "type": "string",
          "maxLength": 64
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stale",
        "uncertain",
        "conflicting",
        "untrusted_content"
      ],
      "properties": {
        "stale": {
          "type": "boolean"
        },
        "uncertain": {
          "type": "boolean"
        },
        "conflicting": {
          "type": "boolean"
        },
        "untrusted_content": {
          "type": "boolean"
        }
      }
    },
    "related_entities": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "label"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        }
      }
    },
    "evidence_ref_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 256
      },
      "uniqueItems": true
    }
  },
  "$id": "https://contracts.fullchaos.dev/acr/v1/context_packet_item.v1.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_kind": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_ref_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
