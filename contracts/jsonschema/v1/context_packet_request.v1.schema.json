{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACR Context Packet Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "goal",
    "repository",
    "scope",
    "options",
    "client"
  ],
  "properties": {
    "schema_version": {
      "const": "context_packet_request.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$",
          "maxLength": 512
        },
        "repo_id": {
          "type": "string",
          "maxLength": 128
        },
        "remote_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "maxLength": 512
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "task_ref": {
          "type": "string",
          "maxLength": 1024
        },
        "files": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "uniqueItems": true
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "time_window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "max_output_tokens",
        "max_serialized_bytes",
        "include_debug",
        "include_low_confidence"
      ],
      "properties": {
        "requested_categories": {
          "type": "array",
          "items": {
            "enum": [
              "state",
              "pressure",
              "cause",
              "evidence",
              "action"
            ]
          },
          "uniqueItems": true
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 500,
          "maximum": 16000
        },
        "max_serialized_bytes": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 1048576
        },
        "include_debug": {
          "type": "boolean"
        },
        "include_low_confidence": {
          "type": "boolean"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sidecar_version": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  },
  "$id": "https://contracts.fullchaos.dev/acr/v1/context_packet_request.v1.schema.json"
}
