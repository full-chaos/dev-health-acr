{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fullchaos.dev/acr/v1/context_fabric_investigation_result.v2.schema.json",
  "title": "ACR Context Fabric Investigation Result v2",
  "description": "CHAOS-4042 (sol-max ruling): identical to Investigation Result v1 in every field except structure_needs, whose anchor_options carry AnchorOptionV2 (membership-verify) semantics instead of AnchorOption (unique-claimant). A result only ever carries this schema_version when it minted at least one membership-verify anchor option; v1 AnchorOption/results stay permanently unique-claimant and are never reinterpreted under this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "context_fabric_investigation_result.v2"
    },
    "result_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "degraded",
        "clarification_required",
        "no_match"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "interpretation": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/InterpretedQuestion"
    },
    "subject_resolution": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/SubjectResolution"
    },
    "answer_plan": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/AnswerPlan"
    },
    "cohort": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/Cohort"
    },
    "direct_judgment": {
      "type": "string",
      "maxLength": 4000
    },
    "current_state": {
      "type": "string",
      "maxLength": 4000
    },
    "strongest_pressures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 50
    },
    "drivers": {
      "type": "array",
      "items": {
        "$ref": "context_fabric_common.v1.schema.json#/$defs/DriverJudgment"
      },
      "maxItems": 50
    },
    "remaining_work": {
      "type": "array",
      "items": {
        "$ref": "context_fabric_common.v1.schema.json#/$defs/Finding"
      },
      "maxItems": 250
    },
    "readiness_gaps": {
      "type": "array",
      "items": {
        "$ref": "context_fabric_common.v1.schema.json#/$defs/Finding"
      },
      "maxItems": 250
    },
    "paths": {
      "type": "array",
      "items": {
        "$ref": "context_fabric_common.v1.schema.json#/$defs/RelationshipPath"
      },
      "maxItems": 250
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "context_fabric_common.v1.schema.json#/$defs/Finding"
      },
      "maxItems": 250
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 100
    },
    "limitations_displaced": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Model-authored limitations the engine dropped to fit a service-authored disclosure inside the limitations cap (CHAOS-3746; the disclosure may be retrieval degradation, a historical-axis statement, a commit retraction, or a clarification override). Absent or zero when nothing was displaced. It cannot be inferred from limitations itself: a displaced list and a list that had room are the same length and both end with the disclosure."
    },
    "evidence_ref_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 256,
        "pattern": "^[^|]*$"
      },
      "maxItems": 500,
      "uniqueItems": true
    },
    "claimed_facts": {
      "type": "array",
      "items": {
        "$ref": "context_fabric_common.v1.schema.json#/$defs/ClaimedFact"
      },
      "maxItems": 250
    },
    "coverage": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/Coverage"
    },
    "versions": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/VersionSet"
    },
    "deterministic_answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 100
    },
    "reused": {
      "type": "boolean",
      "description": "CHAOS-3782: true when this result was served from the immutable result store rather than a fresh investigation. When true, result_id and generated_at name the reused result's own identifier and generation time, not this request's."
    },
    "temporal": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/TemporalLabel"
    },
    "effective_evidence_window": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/EffectiveEvidenceWindow"
    },
    "window_clarification": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/WindowClarification"
    },
    "structure_needs": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/StructureNeedsV2"
    },
    "confirmed_structure": {
      "type": "array",
      "items": {
        "$ref": "context_fabric_common.v1.schema.json#/$defs/ConfirmedStructureEntry"
      },
      "maxItems": 4
    },
    "structure_offer_snapshot": {
      "type": "array",
      "items": {
        "$ref": "context_fabric_common.v1.schema.json#/$defs/StructureOfferSnapshotEntry"
      },
      "maxItems": 80
    },
    "render_shapes": {
      "description": "CHAOS-4415: the OPTIONAL renderable shapes this answer warrants, chosen by deterministic rules from the interpreted intent and this result's own cohort and claimed facts. Absent on every answer no rule fired for.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "context_fabric_common.v1.schema.json#/$defs/RenderShape"
      }
    },
    "completeness": {
      "$ref": "context_fabric_common.v1.schema.json#/$defs/AnswerCompleteness"
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "request_id",
    "generated_at",
    "status",
    "question",
    "interpretation",
    "subject_resolution",
    "direct_judgment",
    "current_state",
    "strongest_pressures",
    "drivers",
    "remaining_work",
    "readiness_gaps",
    "paths",
    "conflicts",
    "limitations",
    "evidence_ref_ids",
    "claimed_facts",
    "coverage",
    "versions",
    "deterministic_answer",
    "warnings",
    "reused",
    "completeness"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "complete",
              "partial"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "direct_judgment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  ]
}
