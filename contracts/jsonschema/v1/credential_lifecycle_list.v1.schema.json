{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fullchaos.dev/acr/v1/credential_lifecycle_list.v1.schema.json",
  "title": "Credential Lifecycle List v1",
  "description": "One page of the read-only credential listing for reconciliation (GET /internal/v1/credentials/lifecycle). Ordered by credential_id; the caller's organization only. status is read from the credential's latest lifecycle event: an unrevoked credential past its expiry reads active until the expiry tick writes its expired event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items", "next_after"],
  "properties": {
    "schema_version": { "const": "credential_lifecycle_list.v1" },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_id", "revision", "status"],
        "properties": {
          "credential_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "revision": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["active", "revoked", "expired"] }
        }
      }
    },
    "next_after": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,128}$" }
  }
}
