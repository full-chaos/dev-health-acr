{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACR Context Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_packet_id",
    "request_id",
    "generated_at",
    "status",
    "goal",
    "repository",
    "requested_scope",
    "resolved_scope",
    "query_version",
    "ranking_version",
    "summary",
    "items",
    "required_checks",
    "recommended_next_steps",
    "freshness",
    "coverage",
    "budget",
    "warnings",
    "compatibility"
  ],
  "properties": {
    "schema_version": {
      "const": "context_packet.v1"
    },
    "context_packet_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "degraded",
        "empty"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$",
          "maxLength": 512
        },
        "repo_id": {
          "type": "string",
          "maxLength": 128
        },
        "remote_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "requested_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "maxLength": 512
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "task_ref": {
          "type": "string",
          "maxLength": 1024
        },
        "files": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "uniqueItems": true
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "time_window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    },
    "resolved_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "repo_slug",
        "resolution",
        "fallback_reasons"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "repo_slug": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "branch": {
          "type": "string",
          "maxLength": 512
        },
        "commit_sha": {
          "type": "string",
          "maxLength": 64
        },
        "resolution": {
          "type": "string",
          "description": "Open vocabulary; documented values: exact_commit, branch_filtered, repo_fallback, unresolved. A client must tolerate values it does not know.",
          "x-documented-values": [
            "exact_commit",
            "branch_filtered",
            "repo_fallback",
            "unresolved"
          ]
        },
        "fallback_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "query_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ranking_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "context_packet_item.v1.schema.json"
      }
    },
    "required_checks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "label",
          "reason",
          "rule_id"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "recommended_next_steps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "label",
          "reason",
          "rule_id"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "stale_after_seconds",
        "watermarks"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "stale_after_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "watermarks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "status"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "last_ingested_at": {
                "type": "string",
                "format": "date-time",
                "description": "Newest stored sync time of this source's rows in the repository (last_synced; work items also ingested_at). For repository_freshness it is the repository row's last_synced, rewritten on every repository sync run. For every other source it is a row WRITE time: a sync that finds nothing new rewrites nothing, so a quiet repository can show an old time here although it synced. It is never an event time (a commit, deploy or work item change). Omitted when the source stores no sync time (status unknown) or holds no rows."
              },
              "last_event_at": {
                "type": "string",
                "format": "date-time",
                "description": "Newest observed_at of this source's rows in scope. Where the source has an event time (commit, review, CI run, deploy, work item update) it is that event time and says how recent the activity is, never how recently the source was synced. Where the source has none (pull requests, commit files, dependencies, the repository row) observed_at is the row's own sync time. No status is judged from it."
              },
              "status": {
                "type": "string",
                "description": "Open vocabulary; documented values: fresh, stale, missing, unavailable, unknown. fresh = last_ingested_at is within stale_after_seconds before as_of. stale is served only for repository_freshness, whose last_ingested_at is a sync run stamp, when older than stale_after_seconds. unknown = rows exist but freshness cannot be judged: the source stores no sync time, only an old row write time (a quiet repository looks the same), or the time could not be read; never stale. A client must tolerate values it does not know.",
                "x-documented-values": [
                  "fresh",
                  "stale",
                  "missing",
                  "unavailable",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources_considered",
        "sources_available",
        "sources_unavailable",
        "partial",
        "degraded_reasons"
      ],
      "properties": {
        "sources_considered": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sources_available": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sources_unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "reason"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "partial": {
          "type": "boolean"
        },
        "degraded_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "items_used",
        "max_output_tokens",
        "estimated_tokens",
        "max_serialized_bytes",
        "serialized_bytes",
        "truncated"
      ],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1
        },
        "items_used": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_serialized_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "serialized_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_version",
        "minimum_sidecar_version",
        "supported_schema_versions"
      ],
      "properties": {
        "service_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "minimum_sidecar_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "supported_schema_versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "retrieval_debug_summary": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "$id": "https://contracts.fullchaos.dev/acr/v1/context_packet.v1.schema.json"
}
