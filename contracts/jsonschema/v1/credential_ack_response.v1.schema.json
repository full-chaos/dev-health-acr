{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fullchaos.dev/acr/v1/credential_ack_response.v1.schema.json",
  "title": "Self Credential Acknowledgement Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "credential_id", "acknowledged_at"],
  "properties": {
    "schema_version": { "const": "credential_ack_response.v1" },
    "credential_id": { "type": "string", "minLength": 8, "maxLength": 256 },
    "acknowledged_at": { "type": "string", "format": "date-time" }
  }
}
