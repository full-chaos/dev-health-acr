                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded device grant approved or advisory hints previewed",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "../jsonschema/v1/device_approval_response.v1.schema.json"
                    },
                    {
                      "$ref": "../jsonschema/v1/device_approval_preview_response.v1.schema.json"
