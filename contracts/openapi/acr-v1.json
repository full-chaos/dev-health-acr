  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "version",
          "checks"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "not_ready"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "fcacr_ client credential"
      },
      "webAssertionAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-ACR-Web-Assertion",
        "description": "Ed25519 request-bound compact JWT assertion for read-only server-to-server web requests. Assertions require the configured issuer, audience, local JWKS key ID, exact method/path/body hash, explicit repository scopes, and a maximum 30-second lifetime."
      }
    },
    "parameters": {
      "RequestID": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Optional correlation ID for request tracing and audit. The service generates and returns a request ID when absent or invalid. It does not authenticate or authorize the caller.",
        "schema": {
          "type": "string",
          "maxLength": 256
        }
      },
      "ClientVersion": {
        "name": "X-ACR-Client-Version",
        "in": "header",
        "required": true,
        "description": "Required SemVer compatibility signal for protected routes. It is advisory only and does not authenticate or authorize the caller; unsupported versions return 426 version_mismatch.",
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Structured safe error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../jsonschema/v1/error.v1.schema.json"
            }
          }
        }
      }
    }
  }
}
