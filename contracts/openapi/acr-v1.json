          "201": {
            "description": "Episode created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/v1/agent_episode.v1.schema.json"
                }
              }
            }
          },
          "204": {
            "description": "Episode accepted with no retained representation"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "426": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
