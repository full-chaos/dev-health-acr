{
  "openapi": "3.1.0",
  "info": {
    "title": "Dev Health Agent Context Runtime API",
    "version": "0.1.0",
    "description": "Private hosted API for evidence-backed agent context packets, authorized provenance expansion, replay snapshots, and opt-in episode writeback. External Push is a separate API plane."
  },
  "servers": [
    {
      "url": "https://acr.fullchaos.dev"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Liveness status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "security": [],
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Service dependencies are ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "One or more service dependencies are not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent-context/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "x-required-scope": "context:read",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          },
          {
            "$ref": "#/components/parameters/ClientVersion"
          }
        ],
        "responses": {
          "200": {
            "description": "Service, schema, entitlement, tool, and limit handshake",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/v1/capabilities.v1.schema.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "426": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/agent-context/context-packets": {
      "post": {
        "operationId": "createContextPacket",
        "x-required-scope": "context:read",
        "x-required-entitlement": "agent_context_runtime",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          },
          {
            "$ref": "#/components/parameters/ClientVersion"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../jsonschema/v1/context_packet_request.v1.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated context packet; status may be complete, partial, degraded, or empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/v1/context_packet.v1.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/agent-context/context-packets/{context_packet_id}": {
      "get": {
        "operationId": "getContextPacket",
        "x-required-scope": "context:read",
        "x-required-entitlement": "agent_context_runtime",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          },
          {
            "$ref": "#/components/parameters/ClientVersion"
          },
          {
            "name": "context_packet_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted immutable packet snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/v1/context_packet.v1.schema.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/agent-context/evidence/{evidence_ref_id}": {
      "get": {
        "operationId": "getEvidence",
        "x-required-scope": "evidence:read",
        "x-required-entitlement": "agent_context_runtime",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          },
          {
            "$ref": "#/components/parameters/ClientVersion"
          },
          {
            "name": "evidence_ref_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Expanded evidence after independent organization and repository authorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/v1/expanded_evidence.v1.schema.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/agent-context/episodes": {
      "post": {
        "operationId": "createEpisode",
        "x-required-scope": "episode:write",
        "x-required-entitlement": "agent_context_runtime",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          },
          {
            "$ref": "#/components/parameters/ClientVersion"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 256
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../jsonschema/v1/agent_episode_create.v1.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing episode returned for an identical idempotent retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/v1/agent_episode.v1.schema.json"
                }
              }
            }
          },
          "201": {
            "description": "Episode created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/v1/agent_episode.v1.schema.json"
                }
              }
            }
          },
          "204": {
            "description": "Episode accepted with no retained representation"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "version",
          "checks"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "not_ready"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "fcacr_ client credential"
      }
    },
    "parameters": {
      "RequestID": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 256
        }
      },
      "ClientVersion": {
        "name": "X-ACR-Client-Version",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Structured safe error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../jsonschema/v1/error.v1.schema.json"
            }
          }
        }
      }
    }
  }
}
